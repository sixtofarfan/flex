<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="trusted_by_section_form_view" model="ir.ui.view">
		<field name="name">reliable.partners.form.view</field>
		<field name="model">reliable.partners</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="image" filename="filename" />
							<field name="filename" invisible="1" />
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="trusted_by_section_tree_view" model="ir.ui.view">
		<field name="name">reliable.partners.tree.view</field>
		<field name="model">reliable.partners</field>
		<field name="arch" type="xml">
			<tree editable="bottom">
				<field name="image" filename="filename" />
				<field name="filename" invisible="1" />
			</tree>
		</field>
	</record>

	<record id="action_reliable_partners" model="ir.actions.act_window">
		<field name="name">Trusted By</field>
		<field name="res_model">reliable.partners</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
		<field name="view_id" ref="trusted_by_section_tree_view" />
		<field name="target">current</field>
	</record>

	<menuitem id="menu_trusted_by" parent="website.menu_website_global_configuration"
		action="action_reliable_partners" sequence="70" />

	<record id="theme_plus_testomonials_form_view" model="ir.ui.view">
		<field name="name">theme.plus.testomonials.form.view</field>
		<field name="model">customers.reviews</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="customer_id" domain="[('customer','=',1)]" />
							<field name="review" />
							<field name="image" invisible="1" />
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="theme_plus_testomonials_tree_view" model="ir.ui.view">
		<field name="name">theme.plus.testomonials.tree.view</field>
		<field name="model">customers.reviews</field>
		<field name="arch" type="xml">
			<tree>
				<field name="customer_id" />
				<field name="review" />
			</tree>
		</field>
	</record>

	<record id="action_customers_reviews" model="ir.actions.act_window">
		<field name="name">Testimonials</field>
		<field name="res_model">customers.reviews</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
	</record>

	<menuitem id="menu_customers_reviews" parent="website.menu_website_global_configuration"
		action="action_customers_reviews" sequence="71" />

	<record id="website_contact_info_form_view" model="ir.ui.view">
		<field name="name">website.contact.info.form.view</field>
		<field name="model">website.contact.info</field>
		<field name="arch" type="xml">
			<form create="false" edit="false">
				<sheet>
					<group>
						<group>
							<field name="name" />
							<field name="email" widget="email" />
						</group>
						<group>
							<field name="subject" />
						</group>
					</group>
					<group>
						<field name="question" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="website_contact_info_tree_view" model="ir.ui.view">
		<field name="name">website.contact.info.tree.view</field>
		<field name="model">website.contact.info</field>
		<field name="arch" type="xml">
			<tree create="false">
				<field name="name" />
				<field name="email" />
				<field name="subject" />
				<field name="question" />
			</tree>
		</field>
	</record>


	<record id="action_website_contact_info" model="ir.actions.act_window">
		<field name="name">Contact Information</field>
		<field name="res_model">website.contact.info</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>

	</record>



	<menuitem id="menu_website_contact_info" parent="website.menu_website_global_configuration"
		action="action_website_contact_info" sequence="72" />


	<record id="res_company_inherit_form_view" model="ir.ui.view">
		<field name="name">res.company.form.view</field>
		<field name="model">res.company</field>
		<field name="inherit_id" ref="base.view_company_form" />
		<field name="arch" type="xml">
			<xpath expr="//sheet/notebook" position="inside">
				<page string="Website Map">
					<group>
						<field name="website_iframe" />
					</group>
				</page>
			</xpath>

			<field name="social_youtube" position="after">
				<field name="social_googleplus" />
			</field>

		</field>
	</record>

	<menuitem name="Website Map" id="website_map_iframe"
		parent="website.menu_website_global_configuration" sequence="50"
		action="base.action_res_company_form" />

	<!-- Meetings Request view -->

	<record id="website_meeting_info_form_view" model="ir.ui.view">
		<field name="name">website.meeting.info.form.view</field>
		<field name="model">website.meeting.info</field>
		<field name="arch" type="xml">
			<form create="false" edit="false">
				<sheet>
					<group>
						<group>
							<field name="name" />
							<field name="email" widget="email" />
						</group>
						<group>
							<label for="meeting_date" string="Meeting Date &amp; Time" />
							<div class="o_row">
								<field string="Meeting Date &amp; Time" name="meeting_date" />
								<field name="meeting_time" />
							</div>
							<field name="phone" widget="phone" />
							<field name="meeting_datetime" invisible="1" />
							<field name="mtime" invisible="1" />
						</group>
					</group>
					<group>
						<field name="question" />
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="website_meeting_info_tree_view" model="ir.ui.view">
		<field name="name">website.meeting.info.tree.view</field>
		<field name="model">website.meeting.info</field>
		<field name="arch" type="xml">
			<tree create="false">
				<field name="name" />
				<field name="email" />
				<field name="meeting_date" />
				<field name="meeting_time" />
				<field name="phone" widget="phone" />
				<field name="question" />
			</tree>
		</field>
	</record>

	<record id="action_website_meeting_request" model="ir.actions.act_window">
		<field name="name">Meetings Request</field>
		<field name="res_model">website.meeting.info</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
	</record>

	<menuitem id="menu_website_meeting_request" parent="website.menu_website_global_configuration"
		action="action_website_meeting_request" sequence="73" />
		
	<!-- Load Custom Demo Data Form -->
	<record model="ir.ui.view" id="load_demo_install_form">
		<field name="name">ir.demo.form</field>
		<field name="model">load.demo</field>
		<field name="arch" type="xml">
			<form>
				<div class="row container">
					<div class="col-12 text-center">
						<p>Load Demo Data</p>
					</div>
				</div>

				<footer>
					<button special="cancel" string="Cancel" class="btn-primary" />
					<button name="install_demo" string="Load Demo Data" type="object"
						class="btn-secondary" />
				</footer>
			</form>
		</field>
	</record>
	<!-- Load Custom Demo Data Action -->
	<record model="ir.actions.act_window" id="load_demo_data_action">
		<field name="name">Load Demo </field>
		<field name="res_model">load.demo</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
	<!-- Load Custom Demo Data Menu -->
	<menuitem id="load_demo_data_menu" parent="website.menu_website_global_configuration"
		action="load_demo_data_action" sequence="74" />
</odoo>