											<strong class="blue">Save precious time</strong>
											and invest it where you need it the most
										</div>
									</li>
								</ul>
							</div> <!-- end of text-container -->
						</div> <!-- end of col -->
						<div class="col-lg-6">

							<!-- Request Form -->
							<div class="form-container">
								<form id="requestForm" data-toggle="validator" data-focus="false"
									action="/meeting_form/" method="post" data-model_name="website.meeting.info"
									class="s_website_form" enctype="multipart/form-data"
									data-editable-form="false" data-success_page="/contactus_thank_you">

									<div class="form-group form-field o_website_form_required_custom">
										<input type="text" class="form-control-input o_website_form_input"
											id="rname" name="name" t-att-value="request.params.get('name', '')"
											required="" />
										<label class="label-control" for="name">Full name</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group form-field o_website_form_required_custom">
										<input type="email" class="form-control-input o_website_form_input"
											id="remail" name="email" t-att-value="request.params.get('email', '')"
											required="" />
										<label class="label-control" for="email">Email</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group form-field o_website_form_required_custom">
										<input type="text" class="form-control-input o_website_form_input"
											id="rphone" name="phone" t-att-value="request.params.get('phone', '')"
											required="" />
										<label class="label-control" for="phone">Phone</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group form-field o_website_form_required_custom">
										<input type="date" class="form-control-input o_website_form_input"
											id="rdate2" name="meeting_datetime" t-att-value="request.params.get('meeting_datetime', '')"
											required="" placeholder="DD-MM-YYYY"></input>
										<label class="label-control" for="meeting_datetime">Meeting Date</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group form-field o_website_form_required_custom">
										<input type="time" class="form-control-input o_website_form_input"
											id="rtime" name="mtime" t-att-value="request.params.get('mtime', '')"
											required=""></input>
										<label class="label-control" for="mtime">Meeting Time</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group form-field o_website_form_required_custom">
										<textarea class="form-control-textarea o_website_form_input"
											id="rmessage" name="question" required="">
											<t t-esc="request.params.get('question', '')" />
										</textarea>
										<label class="label-control" for="question">Interested In</label>
										<div class="help-block with-errors"></div>
									</div>

									<div class="form-group">
