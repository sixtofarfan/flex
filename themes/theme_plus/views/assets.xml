<?xml version="1.0" encoding="utf-8" ?>
<odoo>

	<template id="theme_plus_frontend_js" name="Theme Plus Assets"
		inherit_id="website.assets_frontend">
		<xpath expr="//link[last()]" position="after">

			<link
				href="https://fonts.googleapis.com/css?family=Raleway:400,400i,600,700,700i&amp;subset=latin-ext"
				rel="stylesheet" />
			<link type="image/x-icon" rel="icon"
				href="theme_plus/static/src/img/fevicon-icon.gif" sizes="51x51" />
			<!-- Website Title -->
			<title>Plus - StartUp HTML Landing Page Template</title>
			<link href="/theme_plus/static/src/css/fontawesome-all.css" rel="stylesheet"
				type="text/css" />
			<link href="/theme_plus/static/src/css/swiper.css" rel="stylesheet"
				type="text/css" />
			<link href="/theme_plus/static/src/css/magnific-popup.css" rel="stylesheet"
				type="text/css" />
			<link href="/theme_plus/static/src/css/styles.css" rel="stylesheet"
				type="text/css" />
			<style type="text/css">
				.o_sharing_links a:hover{text-decoration: none;}
				.o_sharing_links a{text-decoration: none;}
				.o_sharing_links
				.fa-twitter{
				padding: 10px;
				background: #00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				.o_sharing_links .fa-facebook-f{
				padding: 10px
				13.4px;
				background: #00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				.o_sharing_links .fa-linkedin-in{
				padding: 10px 11px;
				background:
				#00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				.o_sharing_links
				.fa-google-plus-g {
				padding: 10px 8.3px;
				background: #00bfd8;
				color:
				#fff;
				border-radius: 100%;
				}
				.o_sharing_links .fa-github{
				padding: 10px;
				background: #00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				.o_sharing_links .fa-youtube{
				padding: 10px;
				background: #00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				.o_sharing_links .fa-instagram{
				padding: 10px;
				background: #00bfd8;
				color: #fff;
				border-radius: 100%;
				}
				#wrapwrap .o_header_affix {
				background : #ffffff !important;
				}

			</style>
			<link href="/theme_plus/static/src/scss/website.scss" rel="stylesheet"
				type="text/scss" />
		</xpath>
		<xpath expr="//script[last()]" position="after">
			<script src="/theme_plus/static/src/js/scroll.js" type="text/javascript"></script>
			<script src="/theme_plus/static/src/js/popper.min.js" type="text/javascript"></script><!-- Popper tooltip library for Bootstrap -->
			<script src="/theme_plus/static/src/js/bootstrap.min.js" type="text/javascript"></script> <!-- Bootstrap framework -->
			<script>
				 $("#header_nav .navbar-nav li a").on("click", function(event) {
				    if (!$(this).parent().hasClass('dropdown'))
				        $(".navbar-collapse").collapse('hide');
			     });
			</script>
		</xpath>
	</template>

</odoo>