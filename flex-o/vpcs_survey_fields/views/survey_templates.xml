<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_frontend" inherit_id="website.assets_frontend" name="Survey assets">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/vpcs_survey_fields/static/src/js/survey.js" />
            <link href="/vpcs_survey_fields/static/src/css/custom.css" rel="stylesheet" type="text/css"/>

            <script type="text/javascript" src="/vpcs_survey_fields/static/lib/js/jSignature.js" />
            <script type="text/javascript" src="/vpcs_survey_fields/static/src/js/signature.js"/>
        </xpath>
    </template>

    <template id="m2o_field" name="Many2one field">
        <t t-if="model_name">
            <t t-set="Model" t-value="question.env[model_name].sudo(SUPERUSER_ID)" />
            <t t-set="records" t-value="Model.search([])" />
            <select class="form-control" t-att-name="prefix">
                <option disabled="1" selected="1" value="">
                    <t t-esc="default_placeholder or 'Choose...'" />
                </option>
                <t t-foreach="records" t-as="record">
                    <option t-att-value="record.id">
                        <t t-esc="record.display_name" />
                    </option>
                </t>
            </select>
        </t>
    </template>

    <template id="name_field" name="Address Field">
        <div class="row">
            <div class="col-sm-4 col-xs-12" t-att-id="prefix">
                <input type="text" placeholder="First Name" class="form-control" t-att-name="prefix + '_first_name'"/>
            </div>
            <div class="col-sm-4 col-xs-12" t-att-id="prefix">
                <input type="text" placeholder="Middle Name" class="form-control" t-att-name="prefix + '_middle_name'"/>
            </div>
            <div class="col-sm-4 col-xs-12" t-att-id="prefix">
                <input type="text" placeholder="Last Name" class="form-control" t-att-name="prefix + '_last_name'"/>
            </div>
        </div>
    </template>

    <template id="view_sign_field" name="Signature Field">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default panel-signature">
                    <div class="panel-body">
                        <img alt="Digital Signature" t-att-name="prefix" style="width: 320px; height: 180px"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="binary_field" name="Binary field">
        <input type="file" class="form-control" t-att-name="prefix"/>
    </template>

    <template id="sign_field" name="Signature Field">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default panel-signature">
                    <div class="panel-heading nav">
                        <div class="pull-right">
                            <button type="button" class="btn btn-success js_set_signature">Set</button>
                            <button type="button" class="btn btn-danger js_reset_signature">Reset</button>
                        </div>
                    </div>
                    <div class="panel-body">
                        <input type="hidden" alt="img" t-att-name="prefix" style="display: none;"/>
                        <div class="signature"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="address_field" name="Address Field">
        <div class="row mt8">
            <div class="col-sm-3 field-country">
                <label for="Pais"> País </label>
                <t t-set="countries" t-value="question.env['res.country'].search([])" />
                <select class="form-control" t-att-name="prefix + '_country_id'" id="country_id">
                    <option disabled="1" selected="1" value="">
                        <t t-esc="'Pais'" />
                    </option>
                    <t t-foreach="countries or []" t-as="country">
                        <option t-att-value="country.id">
                            <t t-esc="country.display_name" />
                        </option>
                    </t>
                </select>
            </div>
            <div class="col-sm-3 field-state">
                <label for="Departamento"> Departamento </label>
                <t t-set="states" t-value="question.env['res.country.state'].search([])" />
                <select class="form-control" id="state_id" t-att-name="prefix + '_state_id'">
                    <option disabled="1" selected="1" value="">
                        <t t-esc="'Departamento'" />
                    </option>
                    <t t-foreach="states" t-as="state">
                        <option t-att-value="state.id" t-att-data-country_id="state.country_id.id">
                            <t t-esc="state.display_name" />
                        </option>
                    </t>
                </select>
            </div>
            <div class="col-sm-3 field-province">
                <label for="Provincia"> Provincia </label>
                <t t-set="provinces" t-value="question.env['res.country.province'].search([])" />
                <select class="form-control" id="province_id" t-att-name="prefix + '_province_id'">
                    <option disabled="1" selected="1" value="">
                        <t t-esc="'Provincia'" />
                    </option>
                    <t t-foreach="provinces" t-as="province">
                        <option t-att-value="province.id" t-att-data-state_id="province.state_id.id">
                            <t t-esc="province.display_name" />
                        </option>
                    </t>
                </select>
            </div>
            <div class="col-sm-3 field-district-id">
                <label for="Distrito"> Distrito </label>
                <t t-set="districts" t-value="question.env['res.country.district'].search([])" />
                <select class="form-control" id="district_id" t-att-name="prefix + '_district_id'">
                    <option disabled="1" selected="1" value="">
                        <t t-esc="'Distrito'" />
                    </option>
                    <t t-foreach="districts" t-as="district">
                        <option t-att-value="district.id" t-att-data-province_id="district.province_id.id">
                            <t t-esc="district.display_name" />
                        </option>
                    </t>
                </select>
            </div>
        </div>
        <!-- <div class="row mt8">
            <div class="col-md-12">
                <input type="text" placeholder="Ciudad" class="form-control" t-att-name="prefix + '_city'"/>
            </div>
        </div> -->
        <div class="row mt8">
            <div class="col-md-6">
                <label for="Direccion"> Dirección </label>
                <input type="text" placeholder="Dirección" class="form-control" t-att-name="prefix + '_street'"/>
            </div>
            <div class="col-md-6">
                <label for="Urbanizacion"> Urbanización </label>
                <input type="text" placeholder="Urbanización" class="form-control" t-att-name="prefix + '_street2'"/>
            </div>
        </div>
        
        
