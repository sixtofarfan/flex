<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="wk_location_team_form" model="ir.ui.view">
        <field name="name">wk_location_team_form</field>
        <field name="model">wk.location.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="user_id" domain="[('company_id', '=', company_id)]" class="oe_inline" required="1"/>
                        </h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="country_id" required="1"/>
                        <field name="state_ids" widget="many2many_tags" required="1"
                            domain="[('country_id', '=', country_id), ('state_id', '=', False), ('province_id', '=', False)]"/>
                        <field name="province_ids" widget="many2many_tags" required="1"
                            domain="[('country_id', '=', country_id), ('state_id', 'in', state_ids), ('province_id', '=', False)]"/>
                        <field name="district_ids" widget="many2many_tags"
                            domain="[('country_id', '=', country_id), ('state_id', 'in', state_ids), ('province_id', 'in', province_ids)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="wk_location_team_tree" model="ir.ui.view">
        <field name="name">wk_location_team_tree</field>
        <field name="model">wk.location.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id"/>
                <field name="country_id"/>
                <field name="state_ids"/>
                <field name="province_ids"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
    <record id="wk_location_team_search" model="ir.ui.view">
        <field name="name">wk.location.team.search</field>
        <field name="model">wk.location.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="country_id"/>
            </search>
        </field>
    </record>
    <record id="wk_location_team_action" model="ir.actions.act_window">
        <field name="name">Ubicacion de Diseñadores</field>
        <field name="res_model">wk.location.team</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera tabla aqui
            </p>
        </field>
    </record>
    <menuitem
        id="wk_location_team_menu"
        action="wk_location_team_action"
        parent="odoo_job_costing_management.menu_job_cost_configuration"
        sequence="3"
        groups="project.group_project_user"
    />
</odoo>