<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_renew_bill_wizard" model="ir.ui.view">
            <field name="name">renew.bill.wizard.form</field>
            <field name="model">renew.bill.wizard</field>
            <field name="arch" type="xml">
                <form string="Renewal Bill Wizard">
                    <group>
                        <group>
                            <field name="renew_date" required="1"/>
                            <field name="percentage"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Renew Bills" name="renew_bills_form" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Add action entry in the Action Menu for Send to Bank Bills -->
        <act_window id="act_window_renew_form"
            name="Renew Bills"
            binding_model="account.bill"
            res_model="renew.bill.wizard"
            binding_views="list"
            view_mode="form"
            target="new"
            view_id="view_renew_bill_wizard"
        />

    </data>
</odoo>
