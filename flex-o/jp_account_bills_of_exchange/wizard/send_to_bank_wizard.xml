<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_send_to_bank_wizard" model="ir.ui.view">
            <field name="name">account.send.bank.wizard.form</field>
            <field name="model">account.send.bank.wizard</field>
            <field name="arch" type="xml">
                <form string="Send to Bank">
                    <group>
                        <group>
                            <field name="send_date" required="1"/>
                            <field name="journal_id" domain="[('type','=','boe')]"/>
                            <field name="bank_position" required="1" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Send" name="send_bills_to_bank" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Add action entry in the Action Menu for Send to Bank Bills -->
        <act_window id="act_window_send_to_bank"
            name="Send to Bank"
            binding_model="account.bill"
            res_model="account.send.bank.wizard"
            binding_views="list"
            view_mode="form"
            target="new"
            view_id="view_send_to_bank_wizard"
        />

    </data>
</odoo>
