<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_reconcile_form_wizard" model="ir.ui.view">
            <field name="name">reconcile.form.wizard.form</field>
            <field name="model">reconcile.form.wizard</field>
            <field name="arch" type="xml">
                <form string="Reconcile Form Wizard">
                    <group>
                        <group>
                            <field name="reconcile_date"/>
                            <field name="custom_exchange_rate" invisible="context.get('currency')"/>
                            <field name="exchange_rate" force_save="1" invisible="context.get('currency')" attrs="{'readonly': [('custom_exchange_rate','=',False)]}"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Reconcile" name="send_expenses" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>