<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_import_lines_wizard" model="ir.ui.view">
            <field name="name">import.lines.wizard.form</field>
            <field name="model">import.lines.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Lines Wizard">
                    <group>
                        <group>
                            <field name="excel_file" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Import Lines" name="import_lines_wizard" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>