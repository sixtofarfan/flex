<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_renew_date_wizard" model="ir.ui.view">
            <field name="name">renew.date.wizard.form</field>
            <field name="model">renew.date.wizard</field>
            <field name="arch" type="xml">
                <form string="Renew Date Wizard">
                    <group>
                        <group>
                            <field name="renew_date" required="1"/>
                            <field name="different_journal" invisible="1"/>
                            <field name="journal_id" attrs="{'invisible': [('different_journal','=',False)], 'required': [('different_journal','=',True)]}" domain="[('type','=','bank')]"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="financial_expenses" attrs="{'invisible': [('different_journal','=',False)]}" invisible="context.get('type_bill')"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Renew Bill" name="define_date" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Add action entry in the Action Menu for Pay Bills -->
        <act_window id="act_window_apply_renewals"
            name="Apply renewals"
            binding_model="account.bill"
            res_model="renew.date.wizard"
            binding_views="list"
            view_mode="form"
            target="new"
            view_id="view_renew_date_wizard"
            context="{'massive':  True}" 
        />

    </data>
</odoo>