<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_pay_bill_wizard" model="ir.ui.view">
            <field name="name">pay.bill.wizard.form</field>
            <field name="model">pay.bill.wizard</field>
            <field name="arch" type="xml">
                <form string="Pay Bill Wizard">
                    <group>
                        <group>
                            <field name="payment_date" required="1"/>
                            <field name="sunat_payment_method" required="1" options="{'no_create': True}"/>
                            <field name="operation_number"/>
                            <field name="journal_id" required="1" domain="[('type','=','bank')]"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_amount" invisible="context.get('massive')"/>
                        </group>
                        <group>
                            <field name="custom_exchange_rate"/>
                            <field name="exchange_rate" force_save="1" attrs="{'readonly': [('custom_exchange_rate','=',False)]}"/>
                            <!-- <field name="gloss"/> -->
                            <field name="add_debit_note" invisible="context.get('debit_note')"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Pay Bill" name="pay_bill" type="object" class="oe_highlight" invisible="context.get('massive')"/>
                        <button string="Pay Bill" name="pay_bill_massive" type="object" class="oe_highlight" invisible="not context.get('massive')"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Add action entry in the Action Menu for Pay Bills -->
        <act_window id="act_window_pay_bill_form"
            name="Pay Bills"
            binding_model="account.bill"
            res_model="pay.bill.wizard"
            binding_views="list"
            view_mode="form"
            target="new"
            view_id="view_pay_bill_wizard"
            context="{'massive':  True}"
        />

    </data>
</odoo>