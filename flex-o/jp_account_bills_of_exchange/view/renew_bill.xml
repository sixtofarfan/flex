        <record id="action_renew_customer_forms" model="ir.actions.act_window">
            <field name="name">Renewal Forms</field>
            <field name="res_model">renew.bill.form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_renew_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_renew_form')})]"/>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('origin_bill_ids.type_bill','=','receivable')]</field>
        </record>

        <record id="action_renew_supplier_forms" model="ir.actions.act_window">
            <field name="name">Renewal Forms</field>
            <field name="res_model">renew.bill.form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_renew_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_renew_form')})]"/>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('origin_bill_ids.type_bill','=','payable')]</field>
        </record>

        <menuitem id="menu_account_renew_customer_forms" name="Renewal Forms"
                parent="menu_bills_customer_title"
                action="action_renew_customer_forms" sequence="240"/>

        <menuitem id="menu_account_renew_supplier_forms" name="Renewal Forms"
                parent="menu_bills_supplier_title"
                action="action_renew_supplier_forms" sequence="240"/>

    </data>
