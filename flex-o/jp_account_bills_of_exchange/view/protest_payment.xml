<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_protest_payment_tree" model="ir.ui.view">
            <field name="name">account.protest.payment.tree.view</field>
            <field name="model">account.protest.payment</field>
            <field name="arch" type="xml">
                <tree string="Protest Payments" create="0" edit="0">
                    <field name="name"/>
                    <field name="payment_date"/>
                    <field name="bill_id"/>
                    <field name="currency_id" groups="base.group_multi_currency"/>
                    <field name="exchange_rate" groups="base.group_multi_currency"/>
                    <field name="payment_amount_total"/>
                    <field name="payment_amount_total_signed" groups="base.group_multi_currency"/>
                </tree>
            </field>
        </record>

        <record id="view_protest_payment_form" model="ir.ui.view">
            <field name="name">account.protest.payment.form.view</field>
            <field name="model">account.protest.payment</field>
            <field name="arch" type="xml">
                <form string="Protest Payment" create="0" edit="0">
                    <!-- <header>
                        <button string="Create Renewals" type="object" name="create_renew" class="oe_highlight" attrs="{'invisible':[('state','!=','draft')]}"/>
                        <button string="Cancel" type="object" name="cancel" confirm="Are you sure you want to unreconcile the conciliation and delete the accounting entries?" attrs="{'invisible':[('state','=','draft')]}"/>
                        <field name="state" widget="statusbar" readonly="1"/>
                    </header> -->
                    <sheet string="Protest Payment">
                        <h1 class="mt0">
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                        <group>
                            <group>
                                <field name="payment_date"/>
                                <field name="bill_id"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </group>
                            <group> 
                                <field name="exchange_rate" groups="base.group_multi_currency"/>
                                <field name="payment_amount_total" />
                                <field name="payment_amount_total_signed" groups="base.group_multi_currency" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Journal Items">
                                <group>
                                    <group>
                                        <field name="account_move" invisible="1" readonly="1"/>
                                    </group>
                                    <field name="account_move_line_ids">
                                        <tree>
                                            <field name="date"/>
                                            <field name="move_id"/>
                                            <field name="account_id"/>
                                            <field name="name"/>
                                            <field name="full_reconcile_id"/>
                                            <field name="debit" sum="Total"/>
                                            <field name="credit" sum="Total"/>
                                            <field name="amount_currency"/>
                                            <field name="exchange_rate"/>
                                        </tree>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div> -->
                </form>
            </field>
        </record>

        <record id="action_customer_protest_payments" model="ir.actions.act_window">
            <field name="name">Protest Payments</field>
            <field name="res_model">account.protest.payment</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_protest_payment_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_protest_payment_form')})]"/>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type_form','=', '3')]</field>
        </record>

        <menuitem id="menu_account_customer_protest_payments" name="Protest Payments"
                parent="menu_bills_customer_title"
                action="action_customer_protest_payments" sequence="260"/>

        <record id="action_supplier_protest_payments" model="ir.actions.act_window">
            <field name="name">Protest Payments</field>
            <field name="res_model">account.protest.payment</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_protest_payment_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_protest_payment_form')})]"/>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type_form','=', '4')]</field>
        </record>

        <menuitem id="menu_account_supplier_protest_payments" name="Protest Payments"
                parent="menu_bills_supplier_title"
                action="action_supplier_protest_payments" sequence="260"/>

    </data>
</odoo>
