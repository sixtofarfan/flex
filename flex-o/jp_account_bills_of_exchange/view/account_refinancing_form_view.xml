        <!-- Wizard para solicitar gastos administrativos -->
        <record id="view_admin_interest_wizard" model="ir.ui.view">
            <field name="name">admin.interest.form</field>
            <field name="model">admin.interest</field>
            <field name="arch" type="xml">
                <form string="Interest Administartive Wizard">
                    <group>
                        <field name="interest_administrative" required="1"/>
                    </group>
                    <footer>
                        <button string="Create Debit Note" name="create_debit_note_data" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
