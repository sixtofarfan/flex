<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_move_line_tree_grouped_inherited_boe">
            <field name="name">account.move.line.tree.grouped.inherited.boe</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree_grouped"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='credit']" position="after">
                    <field name="balance" optional="hide"/>
                    <field name="exchange_rate" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_line_tree_inherit_boe" model="ir.ui.view">
            <field name="name">account.move.line.tree.inherited.boe</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='analytic_tag_ids']" position="after">
                    <field name="exchange_rate" optional="show"/>
                    <field name="tc" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_bill_notification_form" model="ir.ui.view">
            <field name="name">account_move_bill_notification_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="after">
                    <field name="invoice_has_outstanding_bills" invisible="1"/>
                    <div groups="account.group_account_invoice" class="alert alert-info" role="alert" style="margin-bottom:0px;" attrs="{'invisible': ['|', '|', ('type', 'not in', ('out_invoice', 'out_refund')), ('invoice_has_outstanding_bills', '=', False), ('invoice_payment_state', '!=', 'not_paid')]}">
                        You have <bold><a class="alert-link" href="#outstanding" role="button">outstanding bills of exchange to accept</a></bold> for this customer. You can reconcile the form to mark this invoice as paid.
                    </div>
                </xpath>
                <xpath expr="//field[@name='id']" position="before">
                    <field name="bill_form_id" invisible="1"/>
                    <widget name="web_ribbon" title="Redeemed" attrs="{'invisible': ['|', ('bill_form_id', '=', False), ('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>
                </xpath>
                <xpath expr="//page[@id='invoice_tab']" position="attributes">
                    <attribute name="attrs">{'invisible': [('type', 'in', ('entry','bill'))]}</attribute>
                </xpath>
                <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'column_invisible': [('parent.type', 'not in', ('entry','bill'))]}</attribute>
                </xpath>
                <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/tree/field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'column_invisible': [('parent.type', 'not in', ('entry','bill'))]}</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='type_document_id']" position="attributes">
                    <attribute name="attrs">{'invisible': [('type', 'in', ('entry','bill'))]}</attribute>
                </xpath> -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|',('type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')),('type', 'in', ('entry','bill'))]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_move_account_fields_it_inherit_form" model="ir.ui.view">
            <field name="name">account_move_account_fields_it_inherit_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account_fields_it.view_move_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type_document_id']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|',('type', 'in', ['out_receipt','in_receipt']),'&amp;',('register_sunat','not in',['1']),('type','in',('entry','bill'))], 'required': ['|',('type','in', ['out_invoice','in_invoice','out_refund','in_refund']),'&amp;',('register_sunat','in',['1']),('type','in',('entry','bill'))],'readonly': [('state', 'in', ['posted','cancel'])]}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
