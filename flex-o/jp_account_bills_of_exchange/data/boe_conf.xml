        <!-- Diario de gastos financieros -->
        <record id="protest_financial_expenses_journal" model="account.journal">
            <field name="name">Intereses y Gastos Financieros de Protestos</field>
            <field name="type">general</field>
            <field name="code">GF</field>
            <field name="default_debit_account_id" ref="jp_account_bills_of_exchange.protest_financial_expenses_journal_credit_account"/>
            <field name="default_credit_account_id" ref="jp_account_bills_of_exchange.protest_financial_expenses_journal_credit_account"/>
            <field name="sequence_id" ref="seq_protest_financial_expenses_journal_sequence"/>
        </record>

        <!-- Secuencia de diario de intereses bancarios -->
        <record id="seq_bank_interests_journal_sequence" model="ir.sequence">
            <field name="name">Secuencia de Diario de Intereses Bancarios</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">IB-</field>
            <field name="padding">7</field>
            <field name="use_date_range">False</field>
        </record>

        <!-- Cuenta de gastos financieros credito -->
