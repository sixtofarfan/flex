        <!-- Diario de intereses bancarios -->
        <record id="bank_interests_journal" model="account.journal">
            <field name="name">Intereses y Gastos Financieros Bancarios</field>
            <field name="type">general</field>
            <field name="code">IB</field>
            <field name="default_debit_account_id" ref="l10n_pe.chart67311"/>
            <field name="default_credit_account_id" ref="l10n_pe.chart67311"/>
            <field name="sequence_id" ref="seq_bank_interests_journal_sequence"/>
        </record>

        <!-- Secuencia de diario de intereses bancarios -->
        <record id="seq_bank_interests_claim_journal_sequence" model="ir.sequence">
            <field name="name">Secuencia de Diario de Reclamo de Intereses Bancarios</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">IB-</field>
            <field name="padding">7</field>
            <field name="use_date_range">False</field>
        </record>

        <!-- Diario de reclamo de intereses bancarios -->
        <record id="bank_interest_claim_account" model="account.journal">
            <field name="name">Reclamo de Intereses Bancarios</field>
            <field name="type">general</field>
            <field name="code">RIB</field>
            <field name="default_debit_account_id" ref="l10n_pe.chart1629"/>
            <field name="default_credit_account_id" ref="l10n_pe.chart1629"/>
            <field name="sequence_id" ref="seq_bank_interests_claim_journal_sequence"/>
        </record>

        <!-- Secuencia de diario de letras en descuento -->
        <record id="seq_discount_bills_journal_sequence" model="ir.sequence">
            <field name="name">Secuencia de Letras en Descuento</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">LED-</field>
            <field name="padding">7</field>
            <field name="use_date_range">False</field>
        </record>

        <!-- Diario de Letras en Descuento -->
        <record id="discount_bills_journal" model="account.journal">
            <field name="name">Letras en Descuento</field>
            <field name="type">boe</field>
            <field name="bank_position">discount</field>
            <field name="code">LED</field>
            <field name="default_debit_account_id" ref="l10n_pe.chart1234"/>
            <field name="default_credit_account_id" ref="l10n_pe.chart45541"/>
            <field name="sequence_id" ref="seq_discount_bills_journal_sequence"/>
        </record>

        <!-- Secuencia de diario de intereses bancarios -->
        <record id="seq_collect_bills_journal_sequence" model="ir.sequence">
            <field name="name">Secuencia de Letras en Conranza</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">LEC-</field>
            <field name="padding">7</field>
            <field name="use_date_range">False</field>
        </record>

        <!-- Diario de Letras en Cobranza -->
        <record id="collect_bills_journal" model="account.journal">
            <field name="name">Letras en Cobranza</field>
            <field name="type">boe</field>
            <field name="bank_position">collection</field>
            <field name="code">LEC</field>
            <field name="default_debit_account_id" ref="l10n_pe.chart1233"/>
            <field name="default_credit_account_id" ref="l10n_pe.chart1233"/>
            <field name="sequence_id" ref="seq_collect_bills_journal_sequence"/>
        </record>

        <!-- Ddefault Journals -->
        <record id="default_customer_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.customer_boe_journal_id</field>
            <field name="value" ref="boe_customer_journal"/>
        </record>

        <record id="default_supplier_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.supplier_boe_journal_id</field>
            <field name="value" ref="boe_supplier_journal"/>
        </record>

        <record id="default_round_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.round_boe_journal_id</field>
            <field name="value" ref="round_journal"/>
        </record>

        <record id="default_protests_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.protests_boe_journal_id</field>
            <field name="value" ref="protests_journal"/>
        </record>

        <record id="default_protest_financial_expenses_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.protests_financial_expenses_boe_journal_id</field>
            <field name="value" ref="protest_financial_expenses_journal"/>
        </record>

        <record id="default_bank_interests_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.bank_interests_boe_journal_id</field>
            <field name="value" ref="bank_interests_journal"/>
        </record>

        <record id="default_bank_interest_claim_journal" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.bank_claim_journal_id</field>
            <field name="value" ref="bank_interest_claim_account"/>
        </record>

        <record id="default_retention_account" model="ir.config_parameter">
            <field name="key">jp_account_bills_of_exchange.retention_boe_account_id</field>
            <field name="value" ref="l10n_pe.chart40114"/>
        </record>

    </data>
