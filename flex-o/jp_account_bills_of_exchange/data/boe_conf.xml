            <field name="code">6794000</field>
            <field name="name">Otros gastos financieros - Letras por cobrar</field>
            <field name="internal_type">other</field>
            <field name="internal_group">expense</field>
            <field name="reconcile">t</field>
            <field name="user_type_id">15</field>
            <field name="group_id" ref="l10n_pe.group12"/>
