<odoo>
	<record id="hr_fixed_inputs_form" model="ir.ui.view">
		<field name="name">hr.fixed.inputs.form</field>
		<field name="model">hr.fixed.inputs</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<field name="employee_id" required="1"/>
						</group>
						<group>
							<field name="company_id" readonly="1"/>
						</group>
					</group>
					<notebook>
						<page string="Conceptos">
							<field name="fixed_line_ids">
								<tree editable="bottom">
									<field name="input_id" required="1"/>
									<field name="amount" sum="amount"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>
	<record id="hr_fixed_inputs_tree" model="ir.ui.view">
		<field name="name">hr.fixed.inputs.tree</field>
		<field name="model">hr.fixed.inputs</field>
		<field name="arch" type="xml">
			<tree>
				<field name="employee_id"/>
				<field name="company_id"/>
			</tree>
		</field>
	</record>
	<record id="hr_fixed_inputs_search" model="ir.ui.view">
		<field name="name">hr.fixed.inputs.search</field>
		<field name="model">hr.fixed.inputs</field>
		<field name="arch" type="xml">
			<search>
				<field name="employee_id"/>
				<field name="company_id"/>
				<separator/>
				<group expand="0" string="Group By...">
					<filter string="Compañia" name="company_id" domain="[]" context="{'group_by':'company_id'}"/>
				</group>
			</search>
		</field>
	</record>
	<record id="hr_fixed_inputs_action" model="ir.actions.act_window">
		<field name="name">Conceptos Fijos</field>
		<field name="res_model">hr.fixed.inputs</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Crea tu primera tabla de Conceptos Fijos aqui
			</p>
		</field>
	</record>
	<menuitem
		id="hr_fixed_inputs_menu"
		action="hr_fixed_inputs_action"
		parent="hr_base_it.menu_hr_tables_configuration"
		sequence="9"
		groups="hr_base_it.group_hr_tables_root"
		/>
</odoo>