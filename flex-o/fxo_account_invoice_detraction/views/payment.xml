<odoo>
  <data>

        <record id="view_payment_detraction_search" model="ir.ui.view">
            <field name="name">account.payment.detraction.search</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='reconciled']" position="after">
                    <filter string="Detractions unpaid" domain="[('is_detraction', '=', True), ('detraction_state','=','0'), ('state','!=','cancelled')]" name="detractions_unpaid"/>
                </xpath>
            </field>
        </record>

        <record id="account_invoice_payment_form" model="ir.ui.view">
            <field name="name">account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_invoice_form"/>
            <field name="arch" type="xml">
                <!-- <field name="journal_id" position="replace">
                    <field name="journal_id" widget="selection" attrs="{'invisible': [('amount', '=', 0)]}" domain="[('bank_account_id.type_of_account','=','2'),('type', 'in', ['bank', 'cash'])]"/>
                </field> -->
                <xpath expr="//div[@name='amount_div']" position="replace">
                    <div name="amount_div" class="o_row">
                        <field name="is_detraction" invisible="1"/>
                        <field name="amount" attrs="{'readonly': [('is_detraction', '=', True)]}"/>
                        <field name="currency_id" attrs="{'readonly': [('is_detraction', '=', True)]}" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="is_detraction" invisible="1"/>
                    <field name="round_amount" attrs="{'invisible': [('is_detraction', '=', False)]}"/>
                    <!-- <field name="type_operation" attrs="{'invisible': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)]}"/>
                    <field name="type_good_service" attrs="{'invisible': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)]}"/> -->
                    <field name="detraction_percent" attrs="{'invisible': [('is_detraction', '=', False)]}"/>
                    <field name="detraction_amount" attrs="{'invisible': [('is_detraction', '=', False)]}"/>
                </xpath>
            </field>
        </record>
        
        <record id="account_payment_form_invoices" model="ir.ui.view">
            <field name="name">account.payment.register.wizard</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_form_multi"/>
            <field name="arch" type="xml">
                <field name="payment_date" position="after">
                    <field name="is_detraction"/>
                    <field name="round_amount" attrs="{'invisible': [('is_detraction', '=', False)]}"/>
                    <field name="type_operation" attrs="{'invisible': [('is_detraction', '=', False)],'readonly': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)]}"/>
                    <field name="type_good_service" attrs="{'invisible': [('is_detraction', '=', False)],'readonly': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)]}"/>
                    <field name="detraction_percent" attrs="{'invisible': [('is_detraction', '=', False)],'readonly': [('is_detraction', '=', False)]}"/>
                    <!-- <field name="detraction_amount" attrs="{'invisible': [('is_detraction', '=', False)],'readonly': [('is_detraction', '=', False)]}"/> -->
                </field>
                <!-- <xpath expr="//div[@name='amount_div']" position="replace">
                    <div name="amount_div" class="o_row">
                        <field name="amount" attrs="{'readonly': ['|',('multi', '=', True),('is_detraction', '=', True)]}"/>
                        <field name="currency_id"
                                attrs="{'readonly': ['|',('multi', '=', True),('is_detraction', '=', True)]}"
                                options="{'no_create': True, 'no_open': True}"
                                groups="base.group_multi_currency"/>
                    </div>
                </xpath> -->
            </field>
        </record>

        <record id="payment_detraction_cancel_form_inherit" model="ir.ui.view">
            <field name="name">payment.detraction.cancel.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="after">
                    <widget name="web_ribbon" text="Paid"
                            attrs="{'invisible': [('detraction_state', '=', '0')]}"/>
                 </xpath>    
                <xpath expr="//header/button[@name='cancel']" position="after">
                    <field name="is_detraction" invisible="1"/>
                    <button name="pay" attrs="{'invisible': ['|','|',('is_detraction', '=', False),('state', 'in', ['draft','cancelled']),('detraction_state', '=', '1')]}" string="Pay detraction" type="object" class="oe_highlight"/>
                    <button name="unpay" attrs="{'invisible': ['|','|',('is_detraction', '=', False),('state', 'in', ['draft','cancelled']),('detraction_state', '=', '0')]}" string="Unpay detraction" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="after">
                    <!-- <field name="type_operation" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': [('is_detraction', '=', False)]}"/>
                    <field name="type_good_service" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': [('is_detraction', '=', False)]}"/> -->
                    <field name="type_operation" attrs="{'invisible': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)], 'required':[('is_detraction', '=', True)]}"/>
                    <field name="type_good_service" attrs="{'invisible': [('is_detraction', '=', False)], 'required':[('is_detraction', '=', True)], 'required':[('is_detraction', '=', True)]}"/>
                    <!-- <field name="detraction_state" attrs="{'readonly': [('state', '!=', 'draft')],'invisible': [('is_detraction', '=', False)]}"/> -->
                    <field name="detraction_state" invisible="1"/>
                    <!-- <widget name="web_ribbon" text="Unpaid"
                            attrs="{'invisible': [('detraction_state', '=', 'paid')]}"/> -->

                </xpath>
            </field>
        </record>

        <record id="action_account_invoice_detraction" model="ir.actions.act_window">
            <field name="name">Register Detratction</field>
            <field name="res_model">account.payment</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="view_id" ref="account.view_account_payment_invoice_form"/>
            <field name="context">{'default_invoice_ids': [(4, active_id, None)], 'default_is_detraction': True}</field>
            <field name="target">new</field>
        </record>



    <record model="ir.actions.server" id="action_detracciones_massive">
        <field name="name">Detracciones Masivas</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">action = records.create_detraccion_masive()</field>
    </record>


        <record id="view_pagos_detraccion_masiva" model="ir.ui.view">
            <field name="name">account.payment.masive.form</field>
            <field name="model">account.payment.masive</field>
            <field name="arch" type="xml">
                <form string="Costo Promedio Producto" version="7.0">
                    <group>
                        <h1>
                            Desea realizar las detracciones masivas?
                        </h1>
                    </group>
                    <footer>
                        <button name="crear_detraction" string="Crear Detracciones" type="object" class="oe_highlight"/>
                        or
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                 </form>
             </field>
        </record>



        <record id="product_normal_form_view" model="ir.ui.view">
            <field name="name">product.product.form</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Detracciones">
                        <group>                            
                            <group>
                                <field name="is_detraction" />
                                <field name="detraction_percent" attrs="{'required':[('is_detraction','=',True)]}" />
                            </group>
                            <group>
                                <field name="type_operation" attrs="{'required':[('is_detraction','=',True)]}"/>
                                <field name="type_good_service" attrs="{'required':[('is_detraction','=',True)]}"/>                                
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

  </data>
</odoo>