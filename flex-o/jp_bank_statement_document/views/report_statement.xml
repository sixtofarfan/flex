<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <template id="report_statement_inherited" inherit_id="account.report_statement">
            <xpath expr="//strong[1]" position="replace">
                <span t-if="o.journal_id.type == 'bank'">Bank Statement <span t-field="o.sequence_number"/></span>
                <span t-else="">Cash Statement <span t-field="o.sequence_number"/></span>
            </xpath>
            <xpath expr="//table[2]" position="replace">
                <!-- <style type="text/css">
                    ul {
                    list-style: none;
                    }
                    ul li::before {
                    content: "\2022";
                    color: red;
                    font-weight: bold;
                    margin-left: -1em;
                    }
                    ol {
                    list-style: none;
                    }
                    ol li::before {
                    content: "\2022";
                    color: green;
                    font-weight: bold;
                    margin-left: -1em;
                    }
                </style> -->
                <table class="table table-borderless m-0">
                    <tr class="border border-top-0 border-right-0 border-left-0 border-info">
                        <td class="p-0 font-weight-bold">
                            <span>Fecha</span>
                        </td>
                        <td class="p-0 font-weight-bold">
                            <span>Descripción</span>
                        </td>
                        <!-- <td class="p-0 font-weight-bold">
                            <span>Ruc/DNI</span>
                        </td> -->
                        <td class="p-0 font-weight-bold">
                            <span>Socio</span>
                        </td>
                        <td class="p-0 font-weight-bold">
                            <span>Tipo Documento</span>
                        </td>
                        <td class="p-0 font-weight-bold">
                            <span>Número</span>
                        </td>
                        <td class="text-right p-0">
                            <span class="d-block font-weight-bold">Importe</span>
                        </td>
                        <!-- <td class="text-right p-0">
                            <span></span>
                        </td> -->
                    </tr>
                    <tbody>
                        <t t-set="total_statement" t-value="0"/>
                        <tr t-foreach="o.line_ids" t-as="line" class="pb-2">
                            <td class="p-0">
                                <span class="font-weight-bold" t-field="line.date"/>
                            </td>
                            <td class="p-0">
                                <span class="font-weight-bold" t-if="line.name" t-field="line.name"/>
                            </td>
                            <!-- <td class="p-0">
                                <span class="font-weight-bold" t-if="line.partner_id" t-field="line.partner_id.vat"/>
                            </td> -->
                            <td class="p-0">
                                <span class="font-weight-bold" t-if="line.partner_id" t-field="line.partner_id"/>
                            </td>
                            <td class="p-0">
                                <span class="font-weight-bold" t-if="line.type_document_id" t-field="line.type_document_id"/>
                            </td>
                            <td class="p-0">
                                <span class="font-weight-bold" t-if="line.ref" t-field="line.ref"/>
                            </td>
                            <td class="text-right p-0">
                                <span class="d-block font-weight-bold" t-field="line.amount"/>
                            </td>
                            <!-- <t t-if="not line.journal_entry_ids">
                                <td class="text-right p-0">
                                    <ul>
                                        <li></li>
                                    </ul>
                                </td>
                            </t> -->
                            <!-- <t t-if="line.journal_entry_ids">
                                <td class="text-right p-0">
                                    <ol>
                                        <li></li>
                                    </ol>
                                </td>
                            </t> -->
                            <t t-set="total_statement" t-value="total_statement + line.amount"/>
                        </tr>
                    </tbody>
                    <tfoot class="table table-lg m-0 table-borderless border border-right-0 border-left-0 border-info">
                        <tr>
                            <td colspan="4" class="text-right p-0 font-weight-bold">Importe Total</td>
                            <td></td>
                            <td class="text-right p-0 font-weight-bold"><t t-esc="'%.2f' % total_statement"/></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </xpath>
        </template>

    </data>
</odoo>