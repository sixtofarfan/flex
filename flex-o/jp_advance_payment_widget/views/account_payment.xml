<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_account_payment_form_widget_inherit" model="ir.ui.view">
			<field name="name">view.account.payment.form.widget.inherit</field>
			<field name="model">account.payment</field>
			<field name="inherit_id" ref="account.view_account_payment_form"/>
			<field name="arch" type="xml">
                <field name="type_change" position="before">
                    <field name="custom_rate"/>
                </field>
				<xpath expr="//field[@name='type_change']" position="attributes">
					<attribute name="attrs">{'readonly': [('custom_rate', '=', False)]}</attribute>
					<attribute name="force_save">1</attribute>
				</xpath>
				<xpath expr="//field[@name='communication']" position="attributes">
					<attribute name="string">Glosa</attribute>
					<attribute name="required">True</attribute>
				</xpath>
			</field>
		</record>
	</data>
</odoo>