<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_main_parameter_form_inherit_advance" model="ir.ui.view">
		<field name="name">main.parameter.form.inherit.advance</field>
		<field name="model">main.parameter</field>
		<field name="inherit_id" ref="account_base_it.view_main_parameter_form"/>
		<field name="arch" type="xml">
			<!-- <field name="supplier_advance_account_fc" position="after">
				<field name="supplier_advance_account_receipt_nc"/>
				<field name="supplier_advance_account_receipt_fc"/>
			</field> -->
			<xpath expr="//page[1]/group[1]" position="after">
				<group string="Other accounts to apply">
					<group>
						<field name="other_accounts_client" widget="many2many">
							<tree>
								<field name="code"/>
								<field name="name"/>
							</tree>
						</field>
					</group>
					<group>
						<field name="other_accounts_supplier" widget="many2many">
							<tree>
								<field name="code"/>
								<field name="name"/>
							</tree>
						</field>
					</group>
				</group>
			</xpath>
		</field>
	</record>
</odoo>