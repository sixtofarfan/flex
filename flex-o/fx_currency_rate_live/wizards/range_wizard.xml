<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_range_wizard" model="ir.ui.view">
            <field name="name">range.wizard.form</field>
            <field name="model">range.wizard</field>
            <field name="arch" type="xml">
                <form string="Range Wizard">
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Update" name="update_currency_range" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>