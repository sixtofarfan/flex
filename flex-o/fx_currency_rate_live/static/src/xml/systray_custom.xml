    <t t-name="odoo13.CurrencyRate">
        <li class="o_timer_systray_item">
            <a class="dropdown-toggle o-no-caret" data-toggle="dropdown" data-display="static" aria-expanded="false" title="Currency Rate" href="#" role="button">
                <i class="fa" role="img" aria-label="Demo Days"/> <span class="o_exchange_rate badge badge-pill"/>
            </a>
            <div class="o_demo_days_systray_dropdown dropdown-menu dropdown-menu-right">
                <a class="dropdown-item">
                  <i><span class="currency_rate_date"/></i>
                </a>
                <a class="dropdown-item">
                  <i><span class="currency_rate_sell"/></i>
                </a>
                <a class="dropdown-item">
                  <i><span class="currency_rate_buy"/></i>
                </a>
                <div class="dropdown-divider" role="separator" />
                <a class="dropdown-item o_update_rate">Update currency rate</a>
                <a class="dropdown-item o_update_rate_range">Update currency rate range</a>
                <a class="dropdown-item o_show_rates">Currency Rates</a>
            </div>
        </li>
    </t>

