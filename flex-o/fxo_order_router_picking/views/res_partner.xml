<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- Add you code here -->
        <!-- model.name inherit form view -->
        <record id="fxo_order_router_picking_view_from" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.view.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='child_ids']//form//sheet//field[@name='phone']" position="after">
                    <field name="router"/>
                </xpath>
                <xpath expr="//field[@name='type']" position="after">
                    <field name="router"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>