<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- Add you code here -->
        <report
                id="stock_picking_router_line"
                model="stock.picking.router.line"
                string="Router"
                report_type="qweb-pdf"
                name="fxo_order_router_picking.report_router"
                file="fxo_order_router_picking.report_router"
            />
        <template id="report_router">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h1><t t-esc="o.name"/></h1>
                            <h2><t t-esc="o.partner_id.name"/></h2>
                            <h2><t t-esc="o.router_id.name"/></h2>                               
                            <table class="table">
                                <colgroup>
                                    <col width="20%"/>
                                    <col width="60%"/>
                                    <col width="20%"/>
                                </colgroup>
                                <thead>
                                    <tr style="background-color: #232020 ; color: #f4f4f4" >
                                        <td>Nombre</td>
                                        <td>Dirrecion</td>
                                        <td>Plan</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.orders_id" t-as="l">
                                        <td><t t-esc="l.partner_id.name"/></td>
                                        <td><t t-esc="l.partner_shipping_id.street"/></td>
                                        <td><t t-esc="l.category.name"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>