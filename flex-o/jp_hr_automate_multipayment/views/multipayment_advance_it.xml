<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multipayment_advance_it_form_view_inherit_hr" model="ir.ui.view">
        <field name="name">multipayment.advance.it.inherit.hr</field>
        <field name="model">multipayment.advance.it</field>
        <field name="inherit_id" ref=""/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="procesing_payments" string="Finalizar" type="object" class="oe_highlight"
                            confirm="Al realizar esta operacion se sobre entiende que ya se generaron los txt y se pagaron todos los montos ¿Esta seguro que desea pasar a estado finalizado?"
                            states="draft"/>
                    <button name="get_hr_txt" string="Generar Txt Haberes" type="object" class="oe_highlight"
                            states="draft,done"/>
                    <button name="get_hr_txt" string="Generar Txt Gratificacion" context="{'gratification':True}"
                            type="object" class="oe_highlight" states="draft,done"/>
                    <button name="get_cts_txt" string="Generar Txt CTS" type="object" class="oe_highlight"
                            states="draft,done"/>
                    <button name="get_utilities_txt" string="Generar Txt Utilidades"
                            type="object" class="oe_highlight" states="draft,done"/>
                    <button name="turn_draft" string="Volver a Borrador" type="object" class="oe_highlight"
                            states="done"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <group>
                    <group>
                        <field name="is_hr_payment" invisible="1"/>
                        <field name="format_bank" invisible="1"/>
                        <field name="journal_id" required="1" attrs="{'readonly':[('state','in',['done'])]}"
                               domain="['|',('type','=','cash'),('type','=','bank')]"/>
                        <field name="payment_date" required="1" attrs="{'readonly':[('state','in',['done'])]}"/>
                        <field name="catalog_payment_id" attrs="{'readonly':[('state','in',['done'])]}"/>
                        <field name="glosa" required="1" attrs="{'readonly':[('state','in',['done'])]}"/>
                        <field name="tc" attrs="{'readonly':[('state','in',['done'])]}" required="1"/>
                    </group>
                    <group>
                        <field name="payslip_run_id"/>
                        <field name="cts_id"/>
                        <field name="cts_dollars"/>
                        <field name="is_biweekly_advance"/>
                        <field name="company_id" readonly="1" required="1" groups="base.group_multi_company"/>
                    </group>
                </group>
                <notebook>
                    <page string="Nominas" id="slips_tab">
                        <field name="slip_ids">
                            <tree>
                                <field name="number"/>
                                <field name="employee_id"/>
                                <field name="wage_account"/>
                                <field name="wage_bank"/>
                                <field name="net_to_pay" sum="net_to_pay"/>
                                <field name="biweekly_advance" sum="biweekly_advance"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                    <page string="CTS" id="cts_tab">
                        <field name="cts_line_ids">
                            <tree>
                                <field name="employee_id"/>
                                <field name="sunat_code"/>
                                <field name="doc_number"/>
                                <field name="cts_account"/>
                                <field name="cts_bank"/>
                                <field name="exchange_type"/>
                                <field name="cts_soles" sum="cts_soles"/>
                                <field name="cts_interest" sum="cts_interest"/>
                                <field name="other_discounts" sum="other_discounts"/>
                                <field name="total_cts" sum="total_cts"/>
                                <field name="cts_dollars" sum="cts_dollars"/>
                            </tree>
                        </field>
                    </page>
                    <page id="config_bank" string="Configuracion de Banco">
                        <center>
                            <h1 attrs="{'invisible': [('format_bank', '!=', False)]}">ESTE BANCO NO TIENE UN FORMATO
                                ESPECIFICADO
                            </h1>
                        </center>
                        <group id="bbva" string="Datos BBVA" attrs="{'invisible': [('format_bank', '!=', 'bbva')]}">
                            <group>
                                <field name="process_type"/>
                                <field name="owner_validation"/>
                            </group>
                            <group>
                                <field name="process_hour" attrs="{'invisible':[('process_type', '!=', 'H')]}"/>
                                <field name="alert_indicator"/>
                            </group>
                        </group>
                        <group id="bcp" string="Datos BCP" attrs="{'invisible': [('format_bank', '!=', 'bcp')]}">
                            <group>
                                <field name="flag"/>
                                <field name="subtype"/>
                            </group>
                            <group>
                                <field name="idc_flag"/>
                            </group>
                        </group>
                        <group id="interbank" string="Datos Interbank"
                               attrs="{'invisible': [('format_bank', '!=', 'interbank')]}">
                            <group>
                                <field name="company_code"/>
                                <field name="service_code"/>
                            </group>
                            <group>
                                <field name="process_type_interbank"/>
                                <field name="person_type"/>
                            </group>
                        </group>
                        <group id="scotiabank" string="Datos Scotiabank"
                               attrs="{'invisible': [('format_bank', '!=', 'scotiabank')]}">
                            <group>
                                <field name="charge_way"/>
                                <field name="payment_way"/>
                            </group>
                            <group>
                                <field name="charge_type"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </form>
        </field>
    </record>
    <record id="action_multipayment_advance_it_hr" model="ir.actions.act_window">
        <field name="name">Pagos Haberes y CTS</field>
        <field name="res_model">multipayment.advance.it</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('account_multipayment_advance_it.multipayment_advance_it_view_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('multipayment_advance_it_form_view_inherit_hr')})]"/>
        <field name="context">{'default_is_hr_payment': True}</field>
        <field name="domain">[('is_hr_payment', '=', True)]</field>
    </record>
    <menuitem
            id="menu_multipayment_advance_it_hr"
            action="action_multipayment_advance_it_hr"
            parent="account_base_it.menu_treasury"
            sequence="7"
            groups="account.group_account_manager"/>


</odoo>