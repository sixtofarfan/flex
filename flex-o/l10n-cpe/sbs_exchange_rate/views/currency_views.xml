<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="view_currency_form_inherit" model="ir.ui.view">
            <field name="name">res.currency.form.inherit</field>
            <field name="model">res.currency</field>
            <field name="inherit_id" ref="base.view_currency_form"/>
			<field name="arch" type="xml">
				<field name="active" position="after">
					<button string="actualizar currency" name="action_sbs_currency" type="object" class="btn-link" invisible="True"/>
				</field>
			</field>
		</record>

		<record id="view_currency_rate_tree_inherit" model="ir.ui.view">
            <field name="name">res.currency.rate.tree</field>
            <field name="model">res.currency.rate</field>
            <field name="inherit_id" ref="base.view_currency_rate_tree" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="sale_type" placeholder="Ejm: 3.25" />
					<field name="purchase_type" placeholder="Ejm: 3.25" />
                </field>
            </field>
        </record>

	</data>
</odoo>
