<odoo>
  <data>

	<record model="ir.ui.view" id="view_company_form">
		<field name="name">stock.picking.form.inherit.l10n.pe.stock</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='pe_type_operation']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//field[@name='pe_number']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//field[@name='pe_transport_mode']" position="attributes">
				<attribute name="required">0</attribute>
			</xpath>
			<xpath expr="//field[@name='pe_carrier_id']" position="attributes">
				<attribute name="required">0</attribute>
			</xpath>
		</field>
	</record>

  </data>
</odoo>