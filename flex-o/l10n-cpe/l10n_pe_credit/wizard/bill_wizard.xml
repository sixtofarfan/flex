<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_bill_wizard" model="ir.ui.view">
            <field name="name">bill.wizard.form</field>
            <field name="model">bill.wizard</field>
            <field name="arch" type="xml">
                <form string="Bills Wizard">
                    <group>
                        <group>
                            <field name="type_bill" required="1" widget="radio"/>
                            <field name="fees_qty" attrs="{'invisible': [('type_bill', '=', 'by_amount')], 'required': [('type_bill', '=', 'by_amount')]}"/>
                            <field name="max_amount" attrs="{'invisible': [('type_bill', '=', 'by_qty')], 'required': [('type_bill', '=', 'by_qty')]}"/>
                            <field name="range_days"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Create fees" name="create_fees" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>