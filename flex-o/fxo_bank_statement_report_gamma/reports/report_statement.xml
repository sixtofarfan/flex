        <template id="report_statement_gamma">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="oe-structure"/>
                        <div class="row">
                            <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                                <colgroup>
                                    <col width="20%"/>
                                    <col width="60%"/>
                                    <col width="20%"/>
                                </colgroup>
                                <tr>
                                    <td style=" text-align: left; font-weight: bold;">
                                        <span t-field="o.company_id.name"/>
                                    </td>
                                    <td style=" text-align: left;">
                                    </td>
                                    <td style=" text-align: right; font-weight: bold;">
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style=" text-align: center; font-weight: bold;">
                                        <strong>CONCILIACION BANCARIA AL:</strong> <span t-field="o.date"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="row">
                            <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                                <colgroup>
                                    <col width="35%"/>
                                    <col width="30%"/>
                                    <col width="35%"/>
                                </colgroup>
                                <tr>
                                    <td style=" text-align: center; font-weight: bold;">
                                        BANCO: <span t-field="o.name"/>
                                    </td>
                                    <td style=" text-align: center; font-weight: bold;">
                                        CTA: <span t-field="o.journal_id.bank_account_id.acc_number"/>
                                    </td>
                                    <td style=" text-align: right; font-weight: bold;">
                                        <t t-if="o.journal_id.currency_id">
                                            MONEDA: <span t-field="o.journal_id.currency_id.name"/>
                                        </t>
                                        <t t-else="">
                                            MONEDA: SOLES
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <hr/>
                        <div class="row">
                            <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                                <colgroup>
                                    <col width="60%"/>
                                    <col width="20%"/>
                                    <col width="20%"/>
                                </colgroup>
                                <tr>
                                    <td style=" text-align: left; ">
                                        SALDOS EN LIBROS AL <span t-field="o.date"/>
                                    </td>
                                    <td style=" text-align: center; ">
                                    </td>
                                    <td style=" text-align: right; ">
                                        <span t-field="o.balance_start"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style=" text-align: center; ">
                                        TOTAL ABONO 
                                    </td>
                                    <td style=" text-align: right; ">
                                        <span t-esc="custom['income']"/>
                                    </td>
                                    <td style=" text-align: right; ">
                                    </td>
                                </tr>
                                <tr>
                                    <td style=" text-align: center; ">
                                        TOTAL CARGO
                                    </td>
                                    <td style=" text-align: right; ">
                                        <span t-esc="custom['charge']"/>
                                    </td>
                                    <td style=" text-align: right; ">
                                        <span t-esc="custom['difference']"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style=" text-align: left; font-weight: bold;">
                                        SALDOS EN LIBROS AL <span t-field="o.date"/>
                                    </td>
                                    <td style=" text-align: right; font-weight: bold;">
                                    </td>
                                    <td style=" text-align: right; font-weight: bold;">
                                        <hr/>
                                        <t t-set="balance" t-esc="custom['difference'] + o.balance_start"/>
                                        <span t-esc="balance"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                            <tbody>
                                <tr style="border-bottom: 1px solid black; border-top: 1px solid black;">
                                    <th>
                                        <center><strong>FECHA</strong></center>
                                    </th>
                                    <th>
                                        <center><strong>DOCUMENTO</strong></center>
                                    </th>
                                    <th>
                                        <center><strong>DESCRIPCION</strong></center>
                                    </th>
                                    <th>
                                        <center><strong>IMPORTE</strong></center>
                                    </th>
                                </tr>
                                <tr>
                                    <td colspan="4"><strong>CARGOS SEGUN LIBROS</strong></td>
                                </tr>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <center><span t-field="line.date"/></center>
                                        </td>
                                        <td>
                                            <center><span t-field="line.ref"/></center>
                                        </td>
                                        <td>
                                            <center><span t-field="line.name"/></center>
                                        </td>
                                        <td>
                                            <center><span t-field="line.amount"/></center>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <hr/>
                        <div>
                            Resumen de Conciliación
                            <div class="row" style="border: 1px solid black">
                                <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                                    <colgroup>
                                        <col width="35%"/>
                                        <col width="15%"/>
                                        <col width="35%"/>
                                        <col width="15%"/>
                                    </colgroup>
                                    <tr>
                                        <td style=" text-align: left;">
                                            CARGOS SEGUN LIBROS (+)
                                        </td>
                                        <td style=" text-align: center; font-weight: bold;">
                                            0.00
                                        </td>
                                        <td style=" text-align: left;">
                                            CARGOS SEGUN ESTADO DE CUENTA (+) 
                                        </td>
                                        <td style=" text-align: center; font-weight: bold;">
                                            0.00
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style=" text-align: left;">
                                            ABONOS SEGUN LIBROS (-)
                                        </td>
                                        <td style=" text-align: center; font-weight: bold;">
                                            0.00
                                        </td>
                                        <td style=" text-align: left;">
                                            ABONOS SEGUN ESTADO DE CUENTA (-) 
                                        </td>
                                        <td style=" text-align: center; font-weight: bold;">
                                            0.00
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="row">
                                <table width="100%" style="font-size:14px; font-family: 'Times New Roman', Times, serif;">
                                    <colgroup>
                                        <col width="50%"/>
                                        <col width="50%"/>
                                    </colgroup>
                                    <tr>
                                        <td style=" text-align: left; font-weight: bold;">
                                            SALDOS EN BANCOS:
                                        </td>
                                        <td style=" text-align: right; font-weight: bold;">
                                            0.00
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>