<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_einvoice_catalog_01_form_inherit" model="ir.ui.view">
		<field name="name">einvoice.catalog.01.form.inherit</field>
		<field name="model">einvoice.catalog.01</field>
		<field name="inherit_id" ref="account_base_it.view_einvoice_catalog_01_form"/>
		<field name="arch" type="xml">
			<field name="description" position="after">
				<field name="bbva_code"/>
				<field name="bcp_code"/>
				<field name="interbank_code"/>
			</field>
		</field>
	</record>
	<record id="view_einvoice_catalog_01_list_inherit" model="ir.ui.view">
		<field name="name">einvoice.catalog.01.list.inherit</field>
		<field name="model">einvoice.catalog.01</field>
		<field name="inherit_id" ref="account_base_it.view_einvoice_catalog_01_list"/>
		<field name="arch" type="xml">
			<field name="description" position="after">
				<field name="bbva_code" optional="hide"/>
				<field name="bcp_code" optional="hide"/>
				<field name="interbank_code" optional="hide"/>
			</field>
		</field>
	</record>
</odoo>