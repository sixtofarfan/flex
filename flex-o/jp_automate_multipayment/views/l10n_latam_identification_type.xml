<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_einvoice_catalog_06_form_inherit" model="ir.ui.view">
		<field name="name">einvoice.catalog.06.form.inherit</field>
		<field name="model">l10n_latam.identification.type</field>
		<field name="inherit_id" ref="account_base_it.view_einvoice_catalog_06_form"/>
		<field name="arch" type="xml">
			<field name="country_id" position="after">
				<field name="bbva_code"/>
				<field name="bcp_code"/>
				<field name="interbank_code"/>
			</field>
		</field>
	</record>
	<record id="view_einvoice_catalog_06_list_inherit" model="ir.ui.view">
		<field name="name">einvoice.catalog.06.list.inherit</field>
		<field name="model">l10n_latam.identification.type</field>
		<field name="inherit_id" ref="account_base_it.view_einvoice_catalog_06_list"/>
		<field name="arch" type="xml">
			<field name="country_id" position="after">
				<field name="bbva_code" optional="hide"/>
				<field name="bcp_code" optional="hide"/>
				<field name="interbank_code" optional="hide"/>
			</field>
		</field>
	</record>
</odoo>