<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_multipayment_advance_wizard_import" model="ir.ui.view">
            <field name="name">multipayment.advance.wizard.form.import</field>
            <field name="model">multipayment.advance.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="sunat_file"/>
                    </group>
                    <footer>
                        <button string="Importar" name="import_sunat_txt" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>