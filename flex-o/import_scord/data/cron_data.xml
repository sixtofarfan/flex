<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="model_import_account_move_cron" model="ir.cron">
        <field name="name">Migracion Facturas Scord-Odoo</field>
        <field name="model_id" ref="model_model_import"/>
