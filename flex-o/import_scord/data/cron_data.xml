        <field name="state">code</field>
        <field name="code">model._cron_import_credit_note()</field>
    </record>
    
    <record id="model_import_purchase_cron" model="ir.cron">
        <field name="name">Migracion Pagos Scord-Odoo</field>
        <field name="model_id" ref="model_model_import"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="code">model._cron_import_purchase()</field>
    </record>

