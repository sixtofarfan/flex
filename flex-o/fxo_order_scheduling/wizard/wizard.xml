<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="account_invoice_confirm_view" model="ir.ui.view">
            <field name="name">sale.order.scheduling.form</field>
            <field name="model">sale.order.scheduling.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Draft Order">
                   <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Generar Order" confirm="Are you sure, Generate all orders"  name="generar_order" type="object" default_focus="1" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_sale_order_scheduling_link" model="ir.actions.act_window">
            <field name="name">Generar Order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.scheduling.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="fxo_order_scheduling.model_sale_order_scheduling" />
            <field name="binding_view_types">list,form</field>
        </record>

        <!-- model.name form view -->
        <record id="order_scheduling_report_wizard_view_wizard" model="ir.ui.view">
            <field name="name">order.scheduling.report.wizard.view.form</field>
            <field name="model">order.scheduling.report.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                     <footer>
                        <button string="Generar Reporte"  name="generar_report" type="object" default_focus="1" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_order_scheduling_report_wizard" model="ir.actions.act_window">
            <field name="name">Generar Order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">order.scheduling.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

         <!-- This Menu Item must have a parent and an action -->
        <menuitem id="order_scheduling_report_wizard_menu" name="Report Lifecafe" 
                    parent="sale.menu_sale_report" 
                    action="action_order_scheduling_report_wizard" 
                    sequence="25"/>


    </data>
</odoo>