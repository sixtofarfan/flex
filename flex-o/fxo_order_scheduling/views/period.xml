<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- period.date tree view -->
        <record id="period_date_view_tree" model="ir.ui.view">
            <field name="name">period.date.view.tree</field>
            <field name="model">period.date</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- Add your fields here -->
                    <field name="name" required="1"/>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                </tree>
            </field>
        </record>
        <!-- period.date form view -->
        <record id="period_date_form" model="ir.ui.view">
            <field name="name">period.date.view.form</field>
            <field name="model">period.date</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <!-- Add your fields here -->
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="period_date_type_action" model="ir.actions.act_window">
            <field name="name">Period</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">period.date</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="period_date_menu" name="Period" parent="sale.sale_order_menu" action="period_date_type_action" sequence="20"/>
    </data>
</odoo>