<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- Add you code here -->
        <report
                id="sale_order_scheduling"
                model="sale.order.scheduling"
                string="Program"
                report_type="qweb-pdf"
                name="fxo_order_scheduling.report_scheduling"
                file="fxo_order_scheduling.report_scheduling"
                attachment_use="True"
                attachment="(object.state in ('done')) and
                    ('Pro'+(object.period_id.name or '').replace('/','')+'.pdf')"
            />
        <report
                id="order_scheduling_report"
                model="order.scheduling.report"
                string="Reporte"
                report_type="qweb-pdf"
                name="fxo_order_scheduling.report_v01"
                file="fxo_order_scheduling.report_v01"
                attachment_use="False"
            />

        <template id="report_scheduling">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2><span t-field="o.period_id.name"/></h2>
                            <p> <span t-field="o.category_id.name"/></p>
                            <t t-foreach="o.line_id" t-as="l">
                                <table class="table">
                                    <colgroup>
                                        <col width="10%"/>
                                        <col width="40%"/>
                                        <col width="14%"/>
                                        <col width="12%"/>
                                        <col width="12%"/>
                                        <col width="12%"/>
                                    </colgroup>
                                    <thead>
                                        <tr class="text-center"  >
                                            <td style="background-color: #ffd271 ; color: #232020" >
                                                <span t-field="o.category_id.name"/>
                                            </td>
                                            <td style="background-color: #232020 ; color: #f4f4f4" >
                                                <span t-field="l.name"/>
                                            </td>
                                            <td style="background-color: #232020 ; color: #f4f4f4">CALORIAS</td>
                                            <td style="background-color: #232020 ; color: #f4f4f4">PROTEINAS</td>
                                            <td style="background-color: #232020 ; color: #f4f4f4">CARBOHIDRATOS</td>
                                            <td style="background-color: #232020 ; color: #f4f4f4">GRASAS</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="text-center" t-foreach="l.scheduling_group_id" t-as="i">
                                            <!-- <td style="background-color: #fff3af ; color: #232020"> -->
                                            <td>
                                                <span t-field="i.type_scheduling"/>
                                            </td>
                                            <td>
                                                <span t-field="i.product_id.name"/>
                                            </td>
                                            <td>
                                                <span t-field="i.proteins"/>
                                            </td>
                                            <td>
                                                <span t-field="i.carohydrates"/>
                                            </td>
                                            <td>
                                                <span t-field="i.fats"/>
                                            </td>
                                            <td>
                                                <span t-field="i.calories"/>
                                            </td>
                                        </tr>
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <td colspan="2" style="text-align: right;">Total</td>
                                            <td style="background-color: #bad043 ; color: #232020; text-align: center;">
                                                <span t-field="l.proteins"/>
                                            </td>
                                            <td style="background-color: #bad043 ; color: #232020; text-align: center;">
                                                <span t-field="l.carohydrates"/>
                                            </td>
                                            <td style="background-color: #bad043 ; color: #232020; text-align: center;">
                                                <span t-field="l.fats"/>
                                            </td>
                                            <td style="background-color: #bad043 ; color: #232020; text-align: center;">
                                                <span t-field="l.calories"/>
                                            </td>
                                        </tr>
                                    </tfoot>

                                </table>
                                <br/>
                            </t>
                            
                        </div>

                    </t>
                </t>
            </t>
        </template>

        <template id="report_v01">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">

                        <style type="text/css">
                            .border-white td {
                            border-top: 1px solid white !important;
                            }
                        </style>

                            <h2>Reporte 1</h2>
                            <h2><span t-field="o.name"/></h2>
                            <t t-set="type" t-value="o.line_id[0].name"/>
                            <t t-set="cant" t-value="0"/>
                            <table class="table">
                                <colgroup>
                                    <col width="10%"/>
                                    <col width="40%"/>
                                    <col width="40%"/>
                                    <col width="10%"/>
                                </colgroup>
                                <thead>
                                    <tr style="background-color: #232020 ; color: #f4f4f4;">
                                        <td>#</td>
                                        <td>Tipo</td>
                                        <td>Plan</td>
                                        <td>Cantidad</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_id" t-as="l">  
                                        <t t-if="type != l.name">
                                            <tr style="max-height: 8px;"> 
                                                <td colspan="3" style="text-align: right;">Total</td>
                                                <td style="background-color: #bad043 ; color: #232020; text-align: center;"><t t-esc="cant"/></td>
                                            </tr>
                                            <tr>
                                                <td colspan=""></td>
                                            </tr>
                                            <tr style="background-color: #232020 ; color: #f4f4f4">
                                                <td>#</td>
                                                <td>Tipo</td>
                                                <td>Plan</td>
                                                <td>Cantidad</td>
                                            </tr>
                                            <t t-set="cant" t-value="0"/>
                                            <t t-set="type" t-value="l.name"/>
                                        </t>
                                        <tr style="max-height: 8px;">
                                            <td>-</td>
                                            <td><span t-field="l.name"/></td>
                                            <td><span t-field="l.category"/></td>
                                            <td style="text-align: center;" ><span t-field="l.qty"/></td>
                                            <t t-set="cant" t-value="l.qty + cant "/>
                                        </tr>     
                                    </t>
                                </tbody>
                            </table>
                            <h2>Reporte 2</h2>
                            <table class="table">
                                <colgroup>
                                    <col width="5%"/>
                                    <col width="35%"/>
                                    <col width="15%"/>
                                    <col width="45%"/>
                                </colgroup>
                                <thead>
                                    <tr style="background-color: #232020 ; color: #f4f4f4">
                                        <td>#</td>
                                        <td>Nombre</td>
                                        <td>Plan</td>
                                        <td>Observación</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr  t-foreach="o.note_ids" t-as="l" style="max-height: 8px;">
                                        <td>#</td>
                                        <td><span t-field="l.name.name"/></td>
                                        <td><span t-field="l.category.name"/></td>
                                        <td><span t-field="l.note_order"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <h2>Reporte 3</h2>
                            <table class="table">
                                <colgroup>
                                    <col width="10%"/>
                                    <col width="70%"/>
                                    <col width="20%"/>
                                </colgroup>
                                <thead>
                                    <tr style="background-color: #232020 ; color: #f4f4f4">
                                        <td>#</td>
                                        <td>Plan</td>
                                        <td>Cantidad</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="cant" t-value="0"/>
                                    <tr  t-foreach="o.product_id" t-as="l" style="max-height: 8px;">
                                        <td>#</td>
                                        <td><span t-field="l.name.name"/> - <span t-field="l.type_producto.name"/></td>
                                        <td><span t-field="l.qty"/></td>
                                        <t t-set="cant" t-value="cant + l.qty"/>
                                    </tr>
                                    <tr style="max-height: 8px;">
                                        <td colspan="2" style="text-align: right;">Total</td>
                                        <td style="background-color: #bad043 ; color: #232020; text-align: center;"><t t-esc="cant"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
