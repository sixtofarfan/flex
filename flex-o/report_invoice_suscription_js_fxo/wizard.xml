<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_report_suscrip" model="ir.ui.view">
        <field name="name">wizard.report.suscrip.form</field>
        <field name="model">wizard.report.suscrip</field>
        <field name="arch" type="xml">
            <form string="Kardex Valorado" version="7.0">
                <group>
                    <group>
                        <field name="fiscal_year_id"
                               options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="period_id"
                               options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>
                    <button name="view_report" string="Ver" type="object" class="oe_highlight"/>
                    or
                    <button string="Cancelar" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_susp" model="ir.actions.act_window">
        <field name="name">Reporte Suscripcion - Facturaciòn</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.report.suscrip</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem action="action_wizard_susp"
              parent="sale_subscription.menu_sale_subscription_report"
              id="main_reporte_suscripcion"
              groups="group_access_not_invoiced_service"
    />
</odoo>