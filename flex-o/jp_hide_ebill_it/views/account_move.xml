<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_move_form_inherit" model="ir.ui.view">
		<field name="name">move.form.inherit</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//button[@name='send_ebill']" position="attributes">
                <attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//notebook/page[last()-1]" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
		</field>
	</record>
	<record id="view_move_tree_inherit" model="ir.ui.view">
		<field name="name">move.tree.inherit</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_invoice_tree"/>
		<field name="arch" type="xml">
			<field name="sunat_state" position="attributes">
				<attribute name="invisible">1</attribute>
			</field>
		</field>
	</record>
</odoo>