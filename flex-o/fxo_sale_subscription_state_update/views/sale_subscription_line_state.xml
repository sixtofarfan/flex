<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_line_state_form" model="ir.ui.view">
        <field name="name">sale.subscription.line.state.form</field>
        <field name="model">sale.subscription.line.state</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="set_draft" string="Volver a Borrador" states="confirmed" type="object"
                            class="oe_highlight"/>
                    <button name="set_confirm" string="Confirmar" states="draft" type="object" class="oe_highlight"/>
                    <button name="finish_line" string="Terminar" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('state_line', '=', 'done')]}"
                            groups="fxo_sale_subscription_state_update.group_finish_line"/>
                    <button name="suspend_line" string="Suspender" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('state_line', 'in', ['suspend', 'cancel'])]}"
                            groups="fxo_sale_subscription_state_update.group_suspend_line"/>
                    <button name="cancel_line" string="Dar de Baja" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('state_line', 'in', ['suspend', 'cancel'])]}"
                            groups="fxo_sale_subscription_state_update.group_cancel_line"/>
                    <button name="set_done" string="Aprobar" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('historical_state', '=', False)]}"
                            confirm="¿Esta seguro que desea aprobar este registro?, una vez hecho esto ya no se podran hacer modificaciones."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="field_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="notes"/>
                            <field name="partner_id"/>
                            <field name="subscription_id" domain="[('partner_id', '=', partner_id)]"
                                   options="{'no_create': 1, 'no_edit': 1}"/>
                            <field name="subscription_line_id" domain="[('analytic_account_id', '=', subscription_id)]"
                                   options="{'no_create': 1, 'no_edit': 1}"/>
                            <field name="stop_date" force_save="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="state_line"/>
                            <field name="historical_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_subscription_line_state_tree" model="ir.ui.view">
        <field name="name">sale.subscription.line.state.tree</field>
        <field name="model">sale.subscription.line.state</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="notes"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="subscription_line_id"/>
                <field name="date"/>
                <field name="stop_date"/>
                <field name="user_id"/>
                <field name="historical_state"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="sale_subscription_line_state_search" model="ir.ui.view">
        <field name="model">sale.subscription.line.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="subscription_line_id"/>
                <field name="date"/>
                <field name="stop_date"/>
                <field name="user_id"/>
                <field name="historical_state"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter name="partner_id" string="Cliente" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="subscription_id" string="Contrato" domain="[]"
                            context="{'group_by': 'subscription_id'}"/>
                    <filter name="subscription_line_id" string="Item del Contrato" domain="[]"
                            context="{'group_by': 'subscription_line_id'}"/>
                    <filter name="date" string="Fecha de Actualizacion" domain="[]" context="{'group_by': 'date'}"/>
                    <filter name="user_id" string="Usuario" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="historical_state" string="Estado actual del Item" domain="[]"
                            context="{'group_by': 'historical_state'}"/>
                    <filter name="state" string="Estado" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sale_subscription_line_state" model="ir.actions.act_window">
        <field name="name">Actualizar Estados de Servicios</field>
        <field name="res_model">sale.subscription.line.state</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera tabla de de Estados de Servicios aqui
            </p>
        </field>
    </record>
    <menuitem
            id="menu_sale_subscription_line_state"
            parent="odoo_job_costing_management.menu_job_cost_project"
            sequence="81"
            action="action_sale_subscription_line_state"
            groups="fxo_sale_subscription_state_update.group_sale_subscription_line_state"
    />
</odoo>