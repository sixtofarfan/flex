<odoo>
    <record id="stock_picking_form_status_inherit_salesman" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.salesman</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="salesman_id"/>
            </field>
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='company_id']" position="after">
                <field name="salesman_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>