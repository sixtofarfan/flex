<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <template id="report_picking_extend_lot" inherit_id="stock.report_picking" name="Repor picking Extend">
            <xpath expr="//table[2]/thead/tr/th[4]" position="after">
                <th t-if="has_serial_number">
                    <strong>Fecha Vencimiento</strong>
                </th>
            </xpath>
            <xpath expr="//table[2]/tbody/tr/td[4]" position="after">
                <th t-if="has_serial_number">
                    <table class="table table-condensed" t-if="pack_operation.pack_lot_ids">
                        <tr t-foreach="pack_operation.pack_lot_ids" t-as="packlot">
                            <td>
                                <t t-if="packlot.lot_id">
                                    <t t-if="packlot.lot_id.life_date">
                                        <t t-esc="packlot.lot_id.life_date[0:10]"/>
                                    </t> 
                                </t>
                            </td>
                        </tr>
                    </table>
                </th>
            </xpath>
        </template>   
    </data>
</odoo>