                                <input type="text" name="phone" t-att-value="phone" id="phone" class="form-control form-control-sm" autofocus="autofocus" autocapitalize="off" required="required" />
                            </div>
                        </div>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                        <div class="col-lg-12  col-sm-12">
                            <div class="clearfix">
                                <button type="submit" class="btn btn-primary float-right mb32 ">
                                    Confirmar
