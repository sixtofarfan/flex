        <template id="fxo_web_signup.portal_my_details" inherit_id="portal.portal_my_details" name="Sign in Login extend">
            <xpath expr="//form[@action='/my/account']" position="replace">
                <br/>
                <form action="/my/account" method="post" class="oe_addres_form"  >
                    <input type="hidden" name="csrf_token" class="oe_signup_form_demo"  t-att-value="request.csrf_token()"/>
                    <div class="row o_portal_details">
                        <!-- Datos Territoriales  -->
                         <div class="col-lg-4 -col-sm-12">
                            <div class="form-group field-login">
                                <label for="l10n_latam_identification_type_id">Tipo de Documento </label>
                                <select class="form-control" name="l10n_latam_identification_type_id" >
                                    <option value="">Seleccionar...</option>
                                    <t t-foreach="type_ids or []" t-as="type_id">

                                         <option t-att-value="type_id.id" t-att-selected="type_id.id == partner.l10n_latam_identification_type_id.id">
                                            <t t-esc="type_id.name" />
                                        </option> 
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 -col-sm-12">
                            <div class="form-group field-vat">
                                <label for="vat">Documento</label>
                                <input type="text" name="vat" id="vat"   t-att-value="vat or partner.vat"  class="form-control form-control-sm" autofocus="autofocus" autocapitalize="off" required="required" t-att-readonly="readonly"/>
                            </div>
                        </div>

                        <div class="col-lg-4  col-sm-12">
                            <div class="form-group field-login">
                                <label for="login">Email</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">@</div>
                                    </div>
                                    <input type="email" name="email" t-attf-class="form-control #{error.get('email') and 'is-invalid' or ''}" t-att-value="email or partner.email"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4  col-sm-12">
                            <div class="form-group field-login">
                                <label for="name_p">Nombre</label>
                                <input type="text" name="name_p" id="name_p"  t-att-value="name_p or partner.name_p" class="form-control form-control-sm" autofocus="autofocus" autocapitalize="off" required="required" />
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group field-last-name">
                                <label for="last_name">Apellidos Paterno</label>
                                <input type="last_name" name="last_name"  t-att-value="name_p or partner.last_name" id="last_name" class="form-control form-control-sm" autofocus="autofocus" autocapitalize="off" required="required" />
