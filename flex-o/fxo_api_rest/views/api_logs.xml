<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="logs_form_view" model="ir.ui.view">
            <field name="name">api.logs.request.form</field>
            <field name="model">api.logs.request</field>
            <field name="arch" type="xml">
                <form string="Logs">
                    <header>
                        <field name="state" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet string="Logs">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="web_service"/>
                                <field name="tipo_solicitud"/>
                            </group>
                            <group>
                                <field name="modelo"/>
                                <field name="fecha_operacion" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="json_in" readonly="1"/>
                            </group>
                            <group>
                                <field name="json_out" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="error_info" string="Error" >
                                <field name="error_details" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_logs_search" model="ir.ui.view">                                
          <field name="name">api.logs.request.search</field>                                
          <field name="model">api.logs.request</field>                                
          <field name="arch" type="xml">                                    
            <search string="Buscar Logs"> 

              <field name="name"></field>

              <filter string="Nuevo" domain="[('state', '=', 'new')]" name="is_new"></filter>
              <filter string="Ejecutado" domain="[('state', '=', 'done')]" name="is_done"></filter>
              <filter string="Error" domain="[('state', '=', 'error')]" name="is_error"></filter>

              <group expand="0" string="Group By">                                            
                <filter string="Webservice" name="web_service" context="{'group_by': 'web_service'}"></filter>
                <filter string="Estado" name="state" context="{'group_by': 'state'}"></filter>
              </group>                                    
            </search>                                
          </field>                            
        </record>

        <record model="ir.ui.view" id="logs_tree_view">
            <field name="name">api.logs.request.tree</field>
            <field name="model">api.logs.request</field>
            <field name="arch" type="xml">
                <tree string="Logs" decoration-info = "state == 'new'" decoration-muted = "state == 'done'" decoration-danger = "state == 'error'" default_order="create_date desc">
                    <field name="create_date" string="Creado en"/>
                    <field name="name"/>
                    <field name="web_service"/>
                    <field name="tipo_solicitud"/>
                    <field name="modelo"/>
                    <field name="fecha_operacion"/>
					<field name="state"/>
                </tree>
            </field>
        </record>

        <record id="ir_cron_act_logs" model="ir.actions.act_window">
            <field name="name">Logs Request</field>
            <field name="res_model">api.logs.request</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="logs_tree_view"/>
            <field name="search_view_id" ref="view_logs_search"></field> 
        </record>

        <menuitem   id="menu_ir_cron_logs" 
                    action="ir_cron_act_logs"
                    name="Log Api"
        />
        
    </data>
</odoo>
