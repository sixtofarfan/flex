<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Add you code here -->
        <!-- sale.order.type inherit form view -->
        <record id="sot_sale_order_type_form_view_extend" model="ir.ui.view">
            <field name="name">sale.order.type.inherit.view.form</field>
            <field name="model">sale.order.type</field>
            <field name="inherit_id" ref="sale_order_type.sot_sale_order_type_form_view"/>
            <field name="arch" type="xml">
                <!-- Add your xpath here -->
                <field name="sequence_id" position="after">
                    <field name="install_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="has_date_update_from" widget="radio" options="{'horizontal': true}"/>
                    <field name="has_date_update_to" widget="radio" options="{'horizontal': true}"/>
                    <field name="has_subscription_update_id" widget="radio" options="{'horizontal': true}"/>
                    <field name="has_signature_date" widget="radio" options="{'horizontal': true}"/>
                    <field name="has_subscription_template_id" widget="radio" options="{'horizontal': true}"/>
                    <field name="change_state" widget="radio" options="{'horizontal': true}"/>
                    <field name="is_migration"/>
                    <field name="is_approval_required"/>
                    <field name="type_select" widget="radio" options="{'horizontal': true}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>