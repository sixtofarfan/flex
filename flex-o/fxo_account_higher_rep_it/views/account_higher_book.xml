<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="view_account_higher_book_tree_inherit" model="ir.ui.view">
		<field name="name">view.account.higher.book.tree.inherit</field>
		<field name="model">account.higher.book</field>
		<field name="inherit_id" ref="account_higher_rep_it.view_account_higher_book_tree"/>
		<field name="arch" type="xml">
			<field name="cuenta" position="after">
				<field name="description"/>
				<field name="circular"/>
				<field name="payment_request"/>
				<field name="operation_number"/>
				<field name="internal_ref"/>
				<field name="internal_ref_child"/>
				<field name="product"/>
			</field>
		</field>
	</record>
	<record id="account_higher_book_search_inherit" model="ir.ui.view">
		<field name="name">account.higher.book.search.inherit</field>
		<field name="model">account.higher.book</field>
		<field name="inherit_id" ref="account_higher_rep_it.account_higher_book_search"/>
		<field name="arch" type="xml">
			<field name="nro_comprobante" position="after">
				<field name="description"/>
				<field name="circular"/>
				<field name="payment_request"/>
				<field name="operation_number"/>
				<field name="internal_ref"/>
				<field name="internal_ref_child"/>
				<field name="product"/>
			</field>
			<filter name="nro_comprobante" position="after">
				<filter string="Descripcion" name="description" context="{'group_by': 'description'}"/>
				<filter string="Circular" name="circular" context="{'group_by': 'circular'}"/>
				<filter string="Solicitud de Pago" name="payment_request" context="{'group_by':'payment_request'}"/>
				<filter string="Numero de Operacion" name="operation_number" context="{'group_by':'operation_number'}"/>
				<filter string="Referencia Interna" name="internal_ref" context="{'group_by':'internal_ref'}"/>
				<filter string="Referencia Interna Hija" name="internal_ref_child" context="{'group_by':'internal_ref_child'}"/>
				<filter string="Producto" name="product" context="{'group_by':'product'}"/>
			</filter>
		</field>
	</record>
</odoo>