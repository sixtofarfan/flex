<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- Add you code here -->
        <report
                id="sale_order_bom"
                model="sale.order.bom"
                string="BOM"
                report_type="qweb-pdf"
                name="fxo_order_bom.report_order_bom"
                file="fxo_order_bom.report_order_bom"
            />
        <template id="report_order_bom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h1>Bill of materials</h1>    
                            <h2><t t-esc="o.name"/></h2>                          
                            <table class="table">
                                <colgroup>
                                    <col width="20%"/>
                                    <col width="60%"/>
                                    <col width="20%"/>
                                </colgroup>
                                <thead>
                                    <tr style="background-color: #232020 ; color: #f4f4f4" >
                                        <t t-set="i" t-value="1"/>
                                        <td>N</td>
                                        <td>Product</td>
                                        <td>Qty</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.sale_bom_line_id" t-as="l">
                                        <td><t t-esc="i"/></td>
                                        <td><t t-esc="l.name.name"/></td>
                                        <td><t t-esc="l.qty"/></td>
                                        <t t-set="i" t-value="i + 1"/>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>