<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kardex" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kardexe</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='production_lot_info']" position="after">
                <!-- <div class="app_settings_block" data-key="account" groups="account.group_account_manager"> -->
                    <h2>Kardex</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" title="None">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Documents</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                <div class="text-muted">
                                    Documents to show on kardex
                                </div>
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="kardex_document" string="Documents on Kardex" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="kardex_document"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>

    <record id="jp_kardex_valorizado_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_kardex"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'stock'}</field>
    </record>
</odoo>
