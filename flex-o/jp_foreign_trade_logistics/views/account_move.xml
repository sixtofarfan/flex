<odoo>
    <data>
    
        <record id="view_move_form_inherit_trade" model="ir.ui.view">
            <field name="name">view.move.form.inherit.trade</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="glosa" position="before">
                    <field name="import_number" attrs="{'invisible': [('type','not in',['in_invoice','in_refund','in_receipt'])]}"/>
                </field>
                <xpath expr="//page[@id='aml_tab']//field[@name='line_ids']//tree/field[@name='name']" position="after">
                    <field name="import_number"/>
                </xpath>
                <xpath expr="//page[@id='other_tab']//group[@name='payments_info_group']" position="after">
                    <group string="Initial Transit" name="initial_transit_group">
                        <field name="transit_move_line_id"/>
                    </group>
                </xpath> 
            </field>
        </record>
        
        <record id="view_account_invoice_filter_inherit_trade" model="ir.ui.view">
            <field name="name">account.invoice.select.inherit.trade</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="import_number"/>
                </field>
                <field name="date" position="after">
                    <field name="line_ids" string="Account" filter_domain="[('line_ids.account_id', 'ilike', self)]"/>
                </field>
            </field>
        </record>

        <record id="view_invoice_tree_inherit_trade" model="ir.ui.view">
            <field name="name">account.invoice.tree.inherit.trade</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="invoice_origin" position="before">
                    <field name="import_number" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_account_move_filter_inherit_trade" model="ir.ui.view">
            <field name="name">account.move.filter.inherit.trade</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="import_number"/>
                </field>
            </field>
        </record>

        <record id="view_move_tree_inherit_trade" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.trade</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <field name="ref" position="before">
                    <field name="import_number" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_move_line_tax_audit_tree_inherit_trade" model="ir.ui.view">
            <field name="name">account.move.line.tax.audit.tree.inherit.trade</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="import_number" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_account_move_line_filter_inherit_trade" model="ir.ui.view">
            <field name="name">account.move.line.filter.inherit.trade</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="import_number"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="view_move_line_tree_grouped_inherited_trade">
            <field name="name">account.move.line.tree.grouped.inherited.trade</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree_grouped"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="before">
                    <field name="import_number" optional="show"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
