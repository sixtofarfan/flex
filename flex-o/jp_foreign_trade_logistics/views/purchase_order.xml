<odoo>
    <data>
    
        <record id="purchase_order_form_inherit_trade" model="ir.ui.view">
            <field name="name">purchase.order.form.trade</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_ref" position="after">
                    <field name="import_number"/>
                </field>
            </field>
        </record>

        <record id="purchase_order_tree_inherit_trade" model="ir.ui.view">
            <field name="name">purchase.order.tree.trade</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <field name="partner_ref" position="before">
                    <field name="import_number" optional="show"/>
                </field>
            </field>
        </record>

        <record id="purchase_order_search_inherit_trade" model="ir.ui.view">
            <field name="name">purchase.order.list.select.trade</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="import_number"/>
                </field>
            </field>
        </record>
    
        <record id="purchase_order_view_tree" model="ir.ui.view">
            <field name="name">purchase.order.view.tree.trade</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <field name="partner_ref" position="before">
                    <field name="import_number" optional="show"/>
                </field>
            </field>
        </record>

        <record id="purchase_order_view_search_inherit_trade" model="ir.ui.view">
            <field name="name">purchase.order.select.trade</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="import_number"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
