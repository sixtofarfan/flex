<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- STOCK.LANDED.COST -->
        <record id='view_stock_landed_cost_form_inherit' model='ir.ui.view'>
            <field name="name">stock.landed.cost.form.inherit</field>
            <field name="model">stock.landed.cost</field>
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
            <field name="arch" type="xml">
                <button name='button_cancel' position='before'>
                    <button name='populate_expenses_bill_ids' type="object"
                        string="Get Expenses Lines"
                        attrs="{'invisible': ['|','&amp;',('expenses_bill_ids', '=', []),('expenses_entry_ids', '=', []),('state','!=','draft')]}"/>
                    <button name='reset_draft' type="object"
                        string="Reset to draft"
                        confirm="Are you sure you want to reset to draft and delete the accounting entries?"
                        attrs="{'invisible': [('state','!=','done')]}"/>
                </button>
                <field name='account_journal_id' position='after'>
                    <field name='product_id' force_save="1" readonly="1" attrs="{'invisible':[('many_products','=',True)]}"/>
                </field>
                <field name='date' position='after'>
                    <field name='foreign_currency_id' force_save="1" attrs="{'readonly':['|',('state','not in','draft'),('vendor_bill_ids','!=',[])]}" groups="base.group_multi_currency"/>
                    <field name='company_currency_id' invisible="1"/>
                    <field name='many_products' invisible="1"/>
                    <field name='import_number'  force_save="1" attrs="{'readonly':['|',('state','not in','draft'),('vendor_bill_ids','!=',[])]}"/>
                    <field name='total_quantity' force_save="1" readonly="1"/>
                </field>
                <xpath expr="//group[2]" position="after">
                    <group string="Foreign Currency" groups="base.group_multi_currency">
                        <field name='amount_total_vendor' force_save="1" readonly="1"/>
                        <field name='amount_total_expenses' force_save="1" readonly="1"/>
                        <field name='amount_total_landed' force_save="1" readonly="1"/>
                        <field name='unit_cost' force_save="1" readonly="1" widget='monetary' options="{'currency_field': 'foreign_currency_id','field_digits': True}" attrs="{'invisible':[('many_products','=',True)]}"/>
                    </group>
                    <group string="Company Currency">
                        <field name='amount_total_vendor_signed' force_save="1" readonly="1"/>
                        <field name='amount_total_expenses_signed' force_save="1" readonly="1"/>
                        <field name='amount_total_landed_signed' force_save="1" readonly="1"/>
                        <field name='unit_cost_signed' force_save="1" readonly="1" widget='monetary' options="{'currency_field': 'company_currency_id','field_digits': True}" attrs="{'invisible':[('many_products','=',True)]}"/>
                    </group>
                </xpath>
                <field name='vendor_bill_id' position='attributes'>
                    <attribute name="invisible">1</attribute>
                </field>
                <field name='picking_ids' position='attributes'>
                    <attribute name="invisible">1</attribute>
                </field>
                <xpath expr="//page[1]" position="before">
                    <page string="Vendor Bills">
                        <field name="vendor_bill_ids" required="1" attrs="{'readonly':[('state','not in','draft')]}" context="{'default_type': 'in_invoice'}" domain="[('state','=','posted'),('type','in',['in_invoice']),('vendor_landed_cost_id','=',False),('expenses_landed_cost_id','=',False),('import_number','=', import_number)]" widget="many2many">
                            <tree>
                                <field name="state" invisible="1"/>
                                <field name="invoice_date"/>
                                <field name="invoice_date_due"/>
                                <field name="partner_id"/>
                                <field name="type_document_id"/>
                                <field name="ref"/>
                                <field name="currency_id" groups="base.group_multi_currency" required="0" readonly="1"/>
                                <field name="currency_rate" groups="base.group_multi_currency"/>
                                <field name="amount_untaxed"/>
                                <field name="amount_untaxed_signed"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Expenses Bills">
                        <field name="expenses_bill_ids" required="1" attrs="{'readonly':[('state','not in','draft')]}" context="{'default_type': 'in_invoice'}" domain="[('state','=','posted'),('type','in',['in_invoice','in_refund']),('vendor_landed_cost_id','=',False),('expenses_landed_cost_id','=',False),('import_number','=', import_number)]" widget="many2many">
                            <tree>
                                <field name="state" invisible="1"/>
                                <field name="invoice_date"/>
                                <field name="invoice_date_due"/>
                                <field name="partner_id"/>
                                <field name="type_document_id"/>
                                <field name="ref"/>
                                <field name="currency_id" groups="base.group_multi_currency" required="0" readonly="1"/>
                                <field name="currency_rate" groups="base.group_multi_currency"/>
                                <field name="amount_untaxed"/>
                                <field name="amount_untaxed_signed"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Expenses Entries">
                        <field name="expenses_entry_ids" required="1" attrs="{'readonly':[('state','not in','draft')]}" domain="[('debit','&gt;',0),('entry_landed_cost_id','=',False),('import_number','=', import_number)]" widget="many2many">
                            <tree>
                                <field name="account_id"/>
                                <field name="partner_id"/>
                                <field name="name"/>
                                <field name="currency_id" groups="base.group_multi_currency" required="0" readonly="1"/>
                                <field name="tc" groups="base.group_multi_currency"/>
                                <field name="amount_currency"/>
                                <field name="debit"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Pickings">
                        <field name="picking_ids" force_save="1" readonly="1" widget="many2many"/>
                    </page>
                </xpath>
            </field>
        </record>
        
        <record id='view_stock_landed_cost_tree_inherit' model='ir.ui.view'>
            <field name="name">stock.landed.cost.tree.inherit</field>
            <field name="model">stock.landed.cost</field>
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_tree"/>
            <field name="arch" type="xml">
                <field name="name" position='after'>
                    <field name="import_number" optional='show'/>
                </field>
                <field name="state" position='after'>
                    <field name="total_quantity" optional='show'/>
                    <field name="foreign_currency_id" optional='show'/>
                    <field name="amount_total_landed" optional='show'/>
                    <field name="unit_cost" optional="show" widget="monetary" options="{'currency_field': 'foreign_currency_id','field_digits': True}"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="unit_cost_signed" optional="show" widget="monetary" options="{'currency_field': 'company_currency_id','field_digits': True}"/>
                </field>
            </field>
        </record>

        <record id="view_stock_landed_cost_search_inherit" model="ir.ui.view">
            <field name="name">stock.landed.cost.search.inherit</field>
            <field name="model">stock.landed.cost</field>
            <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_search"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="import_number" string="Import N°"/>
                    <field name="vendor_bill_ids" string="Vendor bill" filter_domain="[('vendor_bill_ids.ref', 'ilike', self)]"/>
                    <field name="expenses_bill_ids" string="Expense bill" filter_domain="[('expenses_bill_ids.ref', 'ilike', self)]"/>
                </field>
            </field>
        </record>
        
        <menuitem action="stock_landed_costs.action_stock_landed_cost" name="Landed Costs" parent="account.menu_finance_entries_actions" id="menu_account_stock_landed_cost" sequence="115"/>

        <record model="ir.ui.menu" id="stock_landed_costs.menu_stock_landed_cost">
            <field name="action" eval="False"/>
        </record>

    </data>
</odoo>