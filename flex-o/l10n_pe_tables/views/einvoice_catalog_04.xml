<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data >
        <!-- Add you code here -->
        <!-- einvoice.catalog.04 form view -->
        <record id="einvoice_catalog_04_view_form" model="ir.ui.view">
            <field name="name">einvoice.catalog.04.view.form</field>
            <field name="model">einvoice.catalog.04</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <!-- Add your fields here -->
                            <field name="name"/>
                            <field name="code"/>
                            <field name="descriptio"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- einvoice.catalog.04 tree view -->
        <record id="einvoice_catalog_04_view_tree" model="ir.ui.view">
            <field name="name">einvoice.catalog.04.view.tree</field>
            <field name="model">einvoice.catalog.04</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- Add your fields here -->
                    <field name="name"/>
                    <field name="code"/>
                    <field name="descriptio"/>
                </tree>
            </field>
        </record>

        <record id="einvoice_catalog_04_action" model="ir.actions.act_window">
            <field name="name">Catalogo 04 -  Tipo de Via </field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">einvoice.catalog.04</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem   id="menu_einvoice_catalog_04" 
                    name="Catalogo 04 -  Tipo de Via" 
                    parent="account_base_it.menu_account_base_it"
                    action="einvoice_catalog_04_action"/>
    </data>
</odoo>