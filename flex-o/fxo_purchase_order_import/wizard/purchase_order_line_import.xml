<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="purchase_order_line_import_form" model="ir.ui.view">
        <field name="name">purchase.order.line.import.form</field>
        <field name="model">purchase.order.line.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="material_plan_ids">
                    <tree>
                        <field name="product_id" required="1"/>
                        <field name="description" required="1"/>
                        <field name="product_uom_qty" required="1"/>
                        <field name="product_uom" required="1"/>
                        <field name="partner_id" required="1"/>
                        <field name="company_id" required="1"/>
                        <field name="order_id" readonly="1" optional="hide"/>
                        <field name="state" required="1"/>
                    </tree>
                </field>
                <footer>
                    <button string="Importar" name="import_order_lines" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>