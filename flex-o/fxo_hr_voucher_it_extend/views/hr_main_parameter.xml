<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_main_parameter_form_inherit_signature" model="ir.ui.view">
		<field name="name">hr.main.parameter.form.inherit.signature</field>
		<field name="model">hr.main.parameter</field>
		<field name="inherit_id" ref="hr_base_it.hr_main_parameter_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page[@name='voucher']/field[@name='signature']" position="after">
				<group>
					<group>
					</group>
					<group>
						<field name="signature_width" attrs="{'invisible': [('signature', '=', False)]}"/>
						<field name="signature_height" attrs="{'invisible': [('signature', '=', False)]}"/>
					</group>
				</group>
			</xpath>
		</field>
	</record>
</odoo>