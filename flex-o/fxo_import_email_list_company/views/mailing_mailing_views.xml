<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_mail_mass_mailing_form_email_list">
        <field name="name">mailing.mailing.form</field>
        <field name="model">mailing.mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <data>
                <notebook position="before">
                    <group colspan="4" col="4">
                        <field name="send_email_second" attrs="{'invisible':[('is_contact','=',False)]}"/>
                        <field name="is_contact" invisible="1"/>
                    </group>
                </notebook>
            </data>
        </field>
    </record>
</odoo>
