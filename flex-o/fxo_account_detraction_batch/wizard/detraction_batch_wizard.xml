<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_detraction_batch_wizard" model="ir.ui.view">
            <field name="name">detraction.batch.wizard.form</field>
            <field name="model">detraction.batch.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <h2>¿Esta seguro que desea generar Detracciones para todos estos documentos?</h2>
                    <group>
                        <field name="detraction_date" required="True"/>
                    </group>
                    <footer>
                        <button string="Generar" name="get_batch_detraction" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>