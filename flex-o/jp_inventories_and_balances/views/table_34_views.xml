<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		
		<record model="ir.ui.view" id="view_account_table_34_form">
			<field name="name">table.34.form</field>
			<field name="model">table.34</field>
			<field name="arch" type="xml">
				<form string="SUNAT Table 34 ">
                    <sheet>
						<group>
							<group>
								<field name="code" required="1"/>
								<field name="name" required="1"/>
								<field name="sector_id" required="1"/>
								<field name="statement_id" required="1"/>
								<!-- <field name="period" required="1" domain="[('fiscal_year_id','=',exercise),('is_opening_close','=',False)]"/> -->
							</group>
						</group>
                        <notebook>
                            <page string="Accounts">
                                <field name="account_ids" widget="many2many">
                                    <tree>
                                        <field name="code"/>
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
				</form>
			</field>
		</record>

		<record model="ir.ui.view" id="view_account_table_34_list">
			<field name="name">table.34.list</field>
			<field name="model">table.34</field>
			<field name="arch" type="xml">
				<tree string="SUNAT Table 34 ">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="sector_id"/>
                    <field name="statement_id"/>
				</tree>
			</field>
		</record>

		<record id="account_table_34_action" model="ir.actions.act_window">
			<field name="name">Table 34</field>
			<field name="res_model">table.34</field>
			<field name="view_mode">list,form</field>
			<field name="view_ids"
				   eval="
							[
							(5, 0, 0),
							(0, 0, {'view_mode': 'tree', 'view_id': ref('view_account_table_34_list')}),
							(0, 0, {'view_mode': 'form', 'view_id': ref('view_account_table_34_form')}),
						  ]"
			/>
			<!-- <field name="target">new</field> -->
		</record>

		<menuitem action="account_table_34_action" 
				id="menu_finance_sunat_table_34" 
				parent="account_base_it.menu_account_base_it" 
				sequence="300"
                groups="account_base_it.group_account_tables_user"/>

	</data>
</odoo>