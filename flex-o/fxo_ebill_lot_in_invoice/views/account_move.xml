<odoo>
	<record id="view_move_form_inherit" model="ir.ui.view">
		<field name="name">move.form.inherit</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='product_id']" position="after">
                <field name="ref_code" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree//field[@name='product_id']" position="after">
                <field name="ref_code" optional="hide"/>
            </xpath>
			<xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='name']" position="after">
                <button name="get_edit_wizard" string="Editar" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree//field[@name='name']" position="after">
                <button name="get_edit_wizard" string="Editar" type="object" class="oe_highlight" invisible="1"/>
            </xpath>
		</field>
	</record>
</odoo>