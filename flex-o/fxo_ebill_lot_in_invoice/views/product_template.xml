<odoo>
	<record id="product_template_only_form_view_inherit_ref_code" model="ir.ui.view">
		<field name="name">product.template.only.form.inherit.ref_code</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_only_form_view"/>
		<field name="arch" type="xml">
			<field name="barcode" position="after">
				<field name="ref_code"/>
			</field>
		</field>
	</record>
	<record id="product_normal_form_inherit_ref_code" model="ir.ui.view">
		<field name="name">product.normal.form.inherit.ref_code</field>
		<field name="model">product.product</field>
		<field name="inherit_id" ref="product.product_normal_form_view"/>
		<field name="arch" type="xml">
			<field name="barcode" position="after">
				<field name="ref_code"/>
			</field>
		</field>
	</record>
</odoo>