<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_multiple_payment_scotiabank_cts_form" model="ir.ui.view">
		<field name="name">multiple.payment.scotiabank.cts.form</field>
		<field name="model">multiple.payment.scotiabank.cts</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="get_moves" string="Obtener CTS" context="{'bank_type': 'scotiabank_cts'}" type="object" class="oe_highlight" states="draft"/>
					<button name="turn_draft" string="Volver a Borrador" type="object" class="oe_highlight" states="txt"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<group>
						<group>
							<field name="charge_currency_id" required="1"/>
							<field name="register_type"/>
						</group>
						<group>
							<field name="company_code"/>
							<field name="total_charge"/>
						</group>
					</group>
					<field name="line_ids">
						<tree editable="bottom" create="0">
							<field name="move_id"/>
							<field name="payment_acc_number"/>
							<field name="amount"/>
							<field name="cci_acc_number"/>
							<field name="rem_amount"/>
						</tree>
					</field>
				</sheet>
			</form>
		</field>
	</record>
	<record id="view_multiple_payment_scotiabank_cts_tree" model="ir.ui.view">
		<field name="name">multiple.payment.scotiabank.cts.tree</field>
		<field name="model">multiple.payment.scotiabank.cts</field>
		<field name="arch" type="xml">
			<tree>
				<field name="id"/>
				<field name="state"/>
			</tree>
		</field>
	</record>
	<record id="action_multiple_payment_scotiabank_cts" model="ir.actions.act_window">
		<field name="name">Pagos Masivos Scotiabank CTS</field>
		<field name="res_model">multiple.payment.scotiabank.cts</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
		  <p class="o_view_nocontent_smiling_face">
			Crea tu primera tabla de Pagos Masivos Scotiabank CTS aqui
		  </p>
		</field>
	</record>
	<record id="get_scotiabank_cts_txt" model="ir.actions.server">
		<field name="name">Generar txt</field>
		<field name="model_id" ref="fxo_hr_multiple_payment.model_multiple_payment_scotiabank_cts"/>
		<field name="binding_model_id" ref="fxo_hr_multiple_payment.model_multiple_payment_scotiabank_cts"/>
		<field name="state">code</field>
		<field name="code">action = records.get_scotiabank_cts_txt()</field>
	</record>
</odoo>