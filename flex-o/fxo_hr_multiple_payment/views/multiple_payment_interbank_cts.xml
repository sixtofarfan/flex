<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_multiple_payment_interbank_cts_form" model="ir.ui.view">
		<field name="name">multiple.payment.interbank.cts.form</field>
		<field name="model">multiple.payment.interbank.cts</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="get_moves" string="Obtener CTS" context="{'bank_type': 'interbank_cts'}" type="object" class="oe_highlight" states="draft"/>
					<button name="turn_draft" string="Volver a Borrador" type="object" class="oe_highlight" states="txt"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<group>
						<group>
							<field name="charge_account_id"/>
							<field name="charge_currency_id" required="1"/>
							<field name="total_charge"/>
							<field name="company_code"/>
							<field name="service_code"/>
						</group>
						<group>
							<field name="reference"/>
							<field name="process_date"/>
							<field name="process_type"/>
							<field name="after_process_date" attrs="{'invisible': [('process_type', '=', '0')], 'required': [('process_type', '=', '1')]}"/>
						</group>
					</group>
					<p>Nota: La referencia no debe tener letras acentuadas</p>
					<field name="line_ids">
						<tree editable="bottom" create="0">
							<field name="move_id"/>
							<field name="partner_doc_type"/>
							<field name="partner_doc_number"/>
							<field name="payment_acc_number"/>
							<field name="person_type"/>
							<field name="beneficiary_name"/>
							<field name="amount"/>
							<field name="amount_cts"/>
							<field name="doc_type"/>
							<field name="doc_number"/>
							<field name="cell_phone"/>
							<field name="email"/>
						</tree>
					</field>
				</sheet>
			</form>
		</field>
	</record>
	<record id="view_multiple_payment_interbank_cts_tree" model="ir.ui.view">
		<field name="name">multiple.payment.interbank.cts.tree</field>
		<field name="model">multiple.payment.interbank.cts</field>
		<field name="arch" type="xml">
			<tree>
				<field name="charge_account_id"/>
				<field name="state"/>
			</tree>
		</field>
	</record>
	<record id="action_multiple_payment_interbank_cts" model="ir.actions.act_window">
		<field name="name">Pagos Masivos Interbank CTS</field>
		<field name="res_model">multiple.payment.interbank.cts</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
		  <p class="o_view_nocontent_smiling_face">
			Crea tu primera tabla de Pagos Masivos Interbank CTS aqui
		  </p>
		</field>
	</record>
	<record id="get_interbank_cts_txt" model="ir.actions.server">
		<field name="name">Generar txt</field>
		<field name="model_id" ref="fxo_hr_multiple_payment.model_multiple_payment_interbank_cts"/>
		<field name="binding_model_id" ref="fxo_hr_multiple_payment.model_multiple_payment_interbank_cts"/>
		<field name="state">code</field>
		<field name="code">action = records.get_interbank_cts_txt()</field>
	</record>
</odoo>