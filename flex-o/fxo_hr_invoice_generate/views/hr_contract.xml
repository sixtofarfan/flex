<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_contract_form_inherit_voucher" model="ir.ui.view">
		<field name="name">hr.contract.form.inherit.voucher</field>
		<field name="model">hr.contract</field>
		<field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page[@name='information']" position="after">
				<page name="voucher" string="Configuracion Boleta">
					<group>
						<group>
							<field name="salary_rule_ids" widget="many2many_tags"/>
							<field name="product_id"/>
							<field name="journal_id"/>
						</group>
						<group>
							<field name="type_document_id"/>
							<field name="serie_id"/>
						</group>
					</group>
				</page>
			</xpath>
		</field>
	</record>
</odoo>