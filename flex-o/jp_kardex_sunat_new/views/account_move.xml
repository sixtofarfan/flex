<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_account_move_form_inherit">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@id='aml_tab']" position="after">
                    <page id="pickings_tab" string="Pickings" attrs="{'invisible': [('type', 'in', ('entry','bill'))]}">
                        <field name="picking_ids" widget="many2many" domain="[('state','=','done'),'|',('purchase_id','=',purchase_id),('sale_id', 'in', sale_order_ids)]"/>
                        <field name="sale_order_ids" invisible="1"/>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
