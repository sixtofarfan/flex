<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_inventory_form_kardex" model="ir.ui.view">
            <field name="name">stock.inventory.form.kardex</field>
            <field name="model">stock.inventory</field>
            <field name="inherit_id" ref="stock.view_inventory_form"/>
                <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button string="Inventory Lines" type="object" name="action_view_related_inventory_lines" class="oe_stat_button" icon="fa-exchange" attrs="{'invisible': [('state', '!=', 'done'),('type_operation_sunat_id','!=','16')]}"/>
                </div>
                <field name="product_ids" position="after">
                    <field name="type_operation_sunat_id" required="1"/>
                </field>
            </field>
        </record>

        <record id="stock_inventory_line_tree2_kardex" model="ir.ui.view">
            <field name="name">stock.inventory.line.tree2.kardex</field>
            <field name="model">stock.inventory.line</field>
            <field name="inherit_id" ref="stock.stock_inventory_line_tree2"/>
                <field name="arch" type="xml">
                <field name="product_qty" position="after">
                    <field name="initial_cost" attrs="{'invisible': ['|',('sunat_code', '!=', '16'),('state', '!=', 'confirm')]}"/>
                    <field name="currency_id" attrs="{'invisible': ['|',('sunat_code', '!=', '16'),('state', '!=', 'confirm')]}"/>
                    <field name="sunat_code" invisible="1"/>
                </field>
            </field>
        </record>

        <record id="stock_inventory_line_tree_kardex" model="ir.ui.view">
            <field name="name">stock.inventory.line.tree.kardex</field>
            <field name="model">stock.inventory.line</field>
            <field name="inherit_id" ref="stock.stock_inventory_line_tree"/>
                <field name="arch" type="xml">
                <field name="product_uom_id" position="after">
                    <field name="initial_cost"/>
                </field>
            </field>
        </record>

    </data>
</odoo>