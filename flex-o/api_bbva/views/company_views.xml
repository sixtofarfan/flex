<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="uei_view_company_form" model="ir.ui.view">
            <field name="name">res.company.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[1]" position="after">
                    <page groups="base.group_user" string="Integración BBVA">
                        <group>
                            <group string="Información servidor">
                                <field name="param_url"/>
                                <field name="param_db"/>
                            </group>
                            <group string="Información conexión">
                                <field name="param_username"/>
                                <field name="param_password" password="True"/>
                            </group>

                            <group>
                                <button type="object" name="action_consult_params" string="Sincronizar" class="oe_highlight"/>
                            </group>
                            <group>
                            </group>

                            <group col="2" colspan="2">
                                <field name="param_currency_usd"/>
                                <field name="param_currency_pen"/>

                                <label for="param_journal_usd"/>
                                <div>
                                    <field name="param_journal_usd" class="oe_inline"/>
                                    <field name="journal_usd_name" class="oe_inline"/>
                                </div>

                                <label for="param_journal_pen"/>
                                <div>
                                    <field name="param_journal_pen" class="oe_inline"/>
                                    <field name="journal_pen_name" class="oe_inline"/>
                                </div>

                                <label for="param_account_usd"/>
                                <div>
                                    <field name="param_account_usd" class="oe_inline"/>
                                    <field name="account_usd_name" class="oe_inline"/>
                                </div>

                                <label for="param_account_pen"/>
                                <div>
                                    <field name="param_account_pen" class="oe_inline"/>
                                    <field name="account_pen_name" class="oe_inline"/>
                                </div>

                                <field name="bbva_contract_usd"/>
                                <field name="bbva_contract_pen"/>
                                
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>