<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_approval_request_form_inherit_cn" model="ir.ui.view">
		<field name="name">approval.request.form.inherit.cn</field>
		<field name="model">approval.request</field>
		<field name="inherit_id" ref="approvals.approval_request_view_form"/>
		<field name="arch" type="xml">
			<field name="category_id" position="after">
				<field name="has_cn_request" invisible="1"/>
				<field name="request_credit_note_id" attrs="{
					'invisible': [('has_cn_request', '==', 'no')],
					'required': [('has_cn_request', '==', 'required')]
				}"/>
			</field>
		</field>
	</record>
</odoo>