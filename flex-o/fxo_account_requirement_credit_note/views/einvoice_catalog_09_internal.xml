<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_einvoice_catalog_09_internal_form" model="ir.ui.view">
		<field name="name">einvoice.catalog.09.internal.form</field>
		<field name="model">einvoice.catalog.09.internal</field>
		<field name="arch" type="xml">
			<form string="Einvoice Catalog 09 Internal">
				<sheet>
					<group>
						<group>
							<field name="code" required="1"/>
							<field name="name" required="1"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>
	<record id="view_einvoice_catalog_09_internal_list" model="ir.ui.view">
		<field name="name">einvoice.catalog.09.internal.list</field>
		<field name="model">einvoice.catalog.09.internal</field>
		<field name="arch" type="xml">
			<tree>
				<field name="code" optional="show"/>
				<field name="name" optional="show"/>
			</tree>
		</field>
	</record>
	<record id="action_einvoice_catalog_09_internal_form" model="ir.actions.act_window">
		<field name="name">Codigos de tipo de Nota de Credito Electronica Interno</field>
		<field name="res_model">einvoice.catalog.09.internal</field>
		<field name="view_mode">tree,form</field>
		<field name="view_id" ref="view_einvoice_catalog_09_internal_list"/>
		<field name="help" type="html">
		  <p class="o_view_nocontent_smiling_face">
			Crea tu primera tabla de Catalogo 09 Interno aqui
		  </p>
		</field>
	</record>
</odoo>