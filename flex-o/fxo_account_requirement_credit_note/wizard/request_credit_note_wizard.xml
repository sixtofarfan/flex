<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record model="ir.ui.view" id="request_credit_note_wizard_form">
			<field name="name">request.credit.note.wizard.form</field>
			<field name="model">request.credit.note.wizard</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<field name="note"/>
					</group>
					<footer>
						<button string="Cancelar Solicitud" name="set_cancel" type="object" class="oe_highlight"/> 
						<button string="Cancel" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>
	</data>
</odoo>