<odoo>
    <record id="invoice_form_collection_inherit" model="ir.ui.view">
        <field name="name">invoice.form.collection.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="fiscal_position_id" position="after">
                <field name="collection_id"/>
            </field>
            <field name="team_id" position="after">
                <field name="invoice_period_id"/>
            </field>
        </field>
    </record>
    <record id="view_invoice_tree_collection_inherit" model="ir.ui.view">
        <field name="name">invoice.tree.collection.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="collection_id" optional="hide"/>
                <field name="invoice_period_id" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="view_account_invoice_collection_filter" model="ir.ui.view">
        <field name="name">account.invoice.collection.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="collection_id"/>
                <field name="invoice_period_id"/>
            </field>
            <filter name="status" position="after">
                <filter string="Cobrador" name="collection" domain="[]" context="{'group_by': 'collection_id'}"/>
                <filter string="Periodo de Facturacion" name="invoice_period_id" domain="[]" context="{'group_by': 'invoice_period_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
