<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="logs_form_cablego_view" model="ir.ui.view">
            <field name="name">logs.request.cablego.form</field>
            <field name="model">logs.request.cablego</field>
            <field name="arch" type="xml">
                <form string="Logs">
                    <header>

                        <field name="stages_id" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet string="Logs">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id"/>
                                <field name="json_out"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="web_service"/>
                                <field name="json_in"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="error_info" string="Error" >
                                <field name="error_details" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_logs_cablego_search" model="ir.ui.view">                                
          <field name="name">logs.request.cablego.search</field>                                
          <field name="model">logs.request.cablego</field>                                
          <field name="arch" type="xml">                                    
            <search string="Buscar Logs"> 

              <field name="name"></field>

              <filter string="Nuevo" domain="[('stages_id', '=', 'new')]" name="is_new"></filter>
              <filter string="Ejecutado" domain="[('stages_id', '=', 'done')]" name="is_done"></filter>
              <filter string="Error" domain="[('stages_id', '=', 'error')]" name="is_error"></filter>

              <group expand="0" string="Group By">                                            
                <filter string="Webservice" name="web_service" context="{'group_by': 'web_service'}"></filter>
                <filter string="Estado" name="stages_id" context="{'group_by': 'stages_id'}"></filter>
              </group>                                    
            </search>                                
          </field>                            
        </record>

        <record model="ir.ui.view" id="logs_tree_cablego_view">
            <field name="name">logs.request.cablego.tree</field>
            <field name="model">logs.request.cablego</field>
            <field name="arch" type="xml">
                <tree string="Logs" decoration-info = "stages_id == 'new'" decoration-muted = "stages_id == 'done'" decoration-danger = "stages_id == 'error'" default_order="create_date desc">

                    <field name="create_date" string="Creado en"/>
                    <field name="name"/>
                    <field name="email"/>
					<field name="stages_id"/>
                </tree>
            </field>
        </record>

        <record id="ir_cron_act_cablego_logs" model="ir.actions.act_window">
            <field name="name">Logs Cable Go</field>
            <field name="res_model">logs.request.cablego</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="logs_tree_cablego_view"/>
            <field name="search_view_id" ref="view_logs_cablego_search"></field> 
        </record>

        <menuitem id="menu_ir_cron_logs" action="ir_cron_act_cablego_logs"/>
    </data>
</odoo>
