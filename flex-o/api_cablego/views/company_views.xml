<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="uei_view_company_form" model="ir.ui.view">
            <field name="name">res.company.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[1]" position="after">
                    <page groups="base.group_user" string="Integración Cable Go">
                        <group>
                            <group string="Información servidor">
                                <field name="param_url_cablego"/>
                                <field name="param_db_cablego"/>
                            </group>
                            <group string="Información conexión">
                                <field name="param_username_cablego"/>
                                <field name="param_password_cablego" password="True"/>
                            </group>
                        </group>

                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>