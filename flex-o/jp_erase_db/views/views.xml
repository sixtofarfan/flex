<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_erase_wizard_form" model="ir.ui.view">
        <field name="name">erase.wizard.form</field>
        <field name="model">erase.wizard</field>
        <field name="arch" type="xml">
            <form string="Erase Data Wizard">
                <group>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="erase_master_data"/>
                        <field name="reset_sequences"/>
                    </group>
                </group>
                <footer>
                    <button string="Erase Data" confirm="Are you sure you want to erase all the data from the database? This is your last chance, after that you won't be able to restore your data !!!" name="erase_date_wizard" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.server" id="erase_db_action_server">
      <field name="name">Erase Data Server Action</field>
      <field name="model_id" ref="jp_erase_db.model_erase_db"/>
      <field name="state">code</field>
      <field name="code">action = model.erase_data()</field>
    </record>

    <menuitem id="menu_item_erase_data"
              name="Erase Data"
              parent="base.next_id_9"
              action="erase_db_action_server"/>

  </data>
</odoo>