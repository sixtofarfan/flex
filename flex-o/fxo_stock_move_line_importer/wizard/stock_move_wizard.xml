<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="stock_move_wizard_form" model="ir.ui.view">
		<field name="name">stock.move.wizard.form</field>
		<field name="model">stock.move.wizard</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<group>
						<field name="file" widget="file"/>
					</group>
				</group>
				<footer>
					<button string="Importar Lineas" name="import_stock_move_lines" type="object" class="oe_highlight"/>
					<button string="Cancel" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>