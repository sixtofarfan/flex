<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequences -->

        <record id="seq_sale_order" model="ir.sequence">
            <field name="name">Solicitudes de Credito</field>
            <field name="code">res.partner.credit.detail</field>
            <field name="prefix">SC-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        
        <record id="mt_solicitude_confirmed" model="mail.message.subtype">
            <field name="name">Solicitude confirmed</field>
            <field name="res_model">res.partner.credit.detail</field>
            <field name="default" eval="False"/>
            <field name="description">Solicitude confirmed</field>
        </record>
        <record id="mt_solicitude_rejected" model="mail.message.subtype">
            <field name="name">Solicitude rejected</field>
            <field name="res_model">res.partner.credit.detail</field>
            <field name="default" eval="False"/>
            <field name="description">Solicitude rejected</field>
        </record>
        <record id="mt_solicitude_aprove" model="mail.message.subtype">
            <field name="name">Solicitude approve</field>
            <field name="res_model">res.partner.credit.detail</field>
            <field name="default" eval="False"/>
            <field name="description">Solicitude approve</field>
        </record>
    </data>
</odoo>
