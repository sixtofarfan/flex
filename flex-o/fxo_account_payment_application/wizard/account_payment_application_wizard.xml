<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="account_payment_application_wizard_form" model="ir.ui.view">
		<field name="name">account.payment.application.wizard.form</field>
		<field name="model">account.payment.application.wizard</field>
		<field name="arch" type="xml">
			<form>
				<field name="payment_wizard_line_ids">
					<tree editable="bottom">
						<field name="move_id"/>
						<field name="move_line_json_ids" widget="many2many_tags"/>
					</tree>
				</field>
				<footer>
					<button string="Agregar" name="apply_payments" type="object" class="oe_highlight"/> 
					<button string="Cancel" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>