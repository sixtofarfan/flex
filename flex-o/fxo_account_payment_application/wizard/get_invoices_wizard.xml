<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_get_payment_invoices_wizard" model="ir.ui.view">
            <field name="name">get.payment.invoices.wizard.form</field>
            <field name="model">get.payment.invoices.wizard</field>
            <field name="arch" type="xml">
                <form string="Get Invoices Wizard">
                    <group>
                        <field name="invoices" nolabel="1" domain="[context.get('partner_id', False),('state','=','posted'),('type','in',('out_invoice','in_invoice')),('amount_residual','>', 0)]"/>
                    </group>
                    <footer>
                        <button string="Get Invoices" name="insert" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>