<odoo>
	<record id="account_move_form_inherit_show_payments" model="ir.ui.view">
		<field name="name">account.move.form.inherit.show_payments</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']/group[@name='payments_info_group']/field[@name='invoice_partner_bank_id']" position="after">
				<field name="show_all_payments"/>
			</xpath>
		</field>
	</record>
</odoo>