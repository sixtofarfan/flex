<odoo>
  <data>
    <!-- explicit list view definition -->
    
    <record model="ir.ui.view" id="closing_period_view_list">
      <field name="name">closing.period.list</field>
      <field name="model">closing.period</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="location_ids" widget="many2many_tags" domain="[('usage','=','internal')]"/>
          <field name="locked_period"/>
          <field name="initial_date"/>
          <field name="end_date"/>
          <field name="state"/>
          <field name="company_id"/>
        </tree>
      </field>
    </record>
   
    <record model="ir.ui.view" id="closing_period_view_form">
      <field name="name">closing.period.form</field>
      <field name="model">closing.period</field>
      <field name="arch" type="xml">
        <form string="Closing Period">
          <header>
            <button string="Get locked lines" type="object" name="get_cost" class="oe_highlight" attrs="{'invisible':[('state','!=','draft')]}"/>
            <!-- <button string="Close Period" type="object" name="close" attrs="{'invisible':[('state','!=','draft')]}" confirm="Are you sure you want to close the period?"/> -->
            <button string="Clear lines" type="object" name="get_cost" attrs="{'invisible':[('state','!=','data')]}"/>
            <button string="Close Period" type="object" name="close" class="oe_highlight" attrs="{'invisible':['|',('state','!=','data'),('period_lines','=', False)]}" confirm="Are you sure you want to close the period?"/>
            <button string="Cancel" type="object" name="cancel" attrs="{'invisible':[('state','!=','done')]}" confirm="Are you sure you want to cancel the closed period to draft?"/>
            <field name="state" widget="statusbar"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="name" attrs="{'readonly':[('state','!=','draft')]}"/>
                <field name="locked_period" readonly="1" force_save="1"/>
                <field name="location_ids" widget="many2many_tags" domain="[('usage','=','internal')]" attrs="{'readonly':[('state','!=','draft')]}"/>
              </group>
              <group>
                <field name="initial_date" attrs="{'readonly':[('state','!=','draft')]}"/>
                <field name="end_date" attrs="{'readonly':[('state','!=','draft')]}"/>
                <field name="data_date" readonly="1" attrs="{'invisible':[('state','=','draft')]}"/>
                <field name="lock_date" readonly="1" attrs="{'invisible':[('state','!=','done')]}"/>
                <field name="company_id" readonly="1"/>
              </group>
            </group>
            <notebook>
                <page string="Locked Lines">
                    <group>
                        <field name="period_lines" readonly="1" nolabel="1">
                          <tree>
                            <field name="location_id"/>
                            <field name="product_id"/>
                            <field name="uom_uom"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                          </tree>
                        </field>
                    </group>
                </page>
                <page string="Error Lines" attrs="{'invisible': [('period_lines_errors', '=', [])]}">
                    <group>
                        <field name="period_lines_errors" readonly="1" nolabel="1">
                          <tree decoration-danger="is_negative == True">
                            <field name="location_id"/>
                            <field name="product_id"/>
                            <field name="uom_uom"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="is_negative" invisible="1"/>
                          </tree>
                        </field>
                    </group>
                </page>
            </notebook>
          </sheet> 
          <div class="oe_chatter">
              <field name="message_follower_ids" widget="mail_followers"/>
              <field name="activity_ids" widget="mail_activity"/>
              <field name="message_ids" widget="mail_thread"/>
          </div>
        </form>
      </field>
    </record>

    <record id="closing_period_search_view" model="ir.ui.view">
        <field name="name">closing.period.search</field>
        <field name="model">closing.period</field>
        <field eval="10" name="priority"/>
        <field name="arch" type="xml">
            <search string="Closing Period">
                <field name="location_ids" string="Locations" filter_domain="[('location_ids.name', 'ilike', self)]"/>
                <field name="name" string="Name"/>
                <field name="locked_period" string="Period"/>
                <group expand='0' string='Filters'>
                    <filter name='state_done' string="Done closing" domain="[('state','=','done')]"/>
                    <filter name='state_draft' string="Draft closing" domain="[('state','=','draft')]"/>
                </group>
                <group expand='0' string='Group by...'>
                    <filter string='Period' name="locked_period" context="{'group_by': 'locked_period'}"/>
                    <filter string='State' name="state" context="{'group_by': 'state'}"/>
               </group>
            </search>
        </field>
    </record>
   

        <record id="closing_period_action" model="ir.actions.act_window">
            <field name="name">Closing Period</field>
            <field name="res_model">closing.period</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            name="Closing period"
            action="closing_period_action"
            id="closing_period"
            parent="stock.menu_stock_warehouse_mgmt" sequence="10"/>

  </data>
</odoo>