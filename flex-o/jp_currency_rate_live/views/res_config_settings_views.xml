<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.currency.rate.live</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='update_currency_rates_manually']" position="after">
              <button name="update_currency_rates_range" type="object" class="btn-link">
                  <i title="Update range" role="img" aria-label="Update range" class="fa fa-fw fa-history"></i>
              </button>
            </xpath>
        </field>
    </record>

</odoo>
