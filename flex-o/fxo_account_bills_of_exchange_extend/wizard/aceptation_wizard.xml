<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aceptation_wizard_form" model="ir.ui.view">
        <field name="name">aceptation.wizard.form</field>
        <field name="model">aceptation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="aceptation_date" required="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Procesar" name="process_wizard" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>