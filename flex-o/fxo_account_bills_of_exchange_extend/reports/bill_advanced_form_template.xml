<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="account_advanced_bills_print_form"
        model="account.advanced.bill.form"
        string="Print Advanced bills form"
        report_type="qweb-pdf"
        name="fxo_account_bills_of_exchange_extend.template_advanced_bill_form"
        file="fxo_account_bills_of_exchange_extend.template_advanced_bill_form"
        attachment_use="False"
    />
    <report
        id="account_bills_print_form_order"
        model="account.bill.form"
        string="Print bills form"
        report_type="qweb-pdf"
        name="fxo_account_bills_of_exchange_extend.template_advanced_bill_form2"
        file="fxo_account_bills_of_exchange_extend.template_advanced_bill_form2"
        attachment_use="False"
    />
    <report
        id="account_print_bills2"
        model="account.advanced.bill.form"
        string="Imprimir Letras de Anticipo"
        report_type="qweb-pdf"
        name="fxo_account_bills_of_exchange_extend.template_bill2"
        file="fxo_account_bills_of_exchange_extend.template_bill2"
        attachment_use="False"
    />
    <template id="template_advanced_bill_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="fxo_account_bills_of_exchange_extend.advanced_bills_form" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>
    <template id="template_advanced_bill_form2">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="fxo_account_bills_of_exchange_extend.advanced_bills_form2" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>
    <template id="template_bill2">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fxo_account_bills_of_exchange_extend.report_bill2" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="advanced_bills_form">
        
        <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        <div class="header">
            <t t-if="o and o.company_id">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="o and o.company_id and o.company_id.partner_id">
                <t t-set="partner" t-value="o.company_id.partner_id"></t>
            </t>
            
            <table>
                <tr>
                    <td>
                        <br/>
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="float-left" alt="Logo" style="max-height: 80; max-width:80px;"/>
                    </td>
                    <td>
                        <br/>
                        <div style="font-size: 12px; padding-left: 45px;">
                            <b>
                                <span style="font-size: 14px;" t-field="company.name"/>
                            </b>
                            <br/>
                            <span t-field="partner.street"/>
                            <br/>
                            <span t-field="partner.street2"/>
                            <br/>
                            <span t-field="partner.state_id.name"/>-<span t-field="partner.city_id.name"/>-<span t-field="partner.l10n_pe_district.name"/>                                
                        </div>
                    </td>
                </tr>
            </table>
        </div>
        <div class="page" style="margin-top: 30px;">
            <div class="dets_order">
                <table width="100%">
                    <thead style=" background-color: #C9CAC9;">
                        <tr>
                            <th colspan="4" width="100%" style="text-align: center;font-size: 11px;">REPORTE DE LIQUIDACION DE LETRAS - <span t-field="o.name"/></th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 12px;">
                        <tr>
                            <td width="50%"><b>SEÑORES: </b><span t-field="o.partner_id.name"/> </td>
                            <td width="50%"><b>DIRECCIÓN: </b><span t-field="o.partner_id.street"/> </td>
                        </tr>
                        <tr>
                            <td width="50%"><b>RUC: </b><span t-field="o.partner_id.vat"/></td>
                            <td width="50%"><b>CODIGO CLIENTE: </b><span t-field="o.partner_id.ref"/></td>
                        </tr>
                        <tr>
                            <td width="50%"><b>DOCUMENTOS: </b><span t-esc="len(o.bill_ids)"/></td>
                            <td width="50%"><b>MONEDA: </b><span t-field="o.currency_id.name"/></td>
                        </tr>
                        <tr>
                            <td width="50%"><b>TASA: </b><span t-field="o.interest_percent"/></td>
                        </tr>
                    </tbody>
                </table>
                <h2>Letras</h2>
                <table width="100%" style="font-size: 11px;border-top:1px solid black">
                    <thead>
                        <tr>
                            <th style="text-align: left;">Nro. Letra</th>
                            <th style="text-align: left;">Orden</th>
                            <th style="text-align: left;">F. Emi</th>
                            <th style="text-align: left;">F. Venc</th>
                            <th style="text-align: left;">Dias Plazo</th>
                            <th style="text-align: left;">Capital</th>
                            <th style="text-align: left;">Interes</th>
                            <th style="text-align: left;">Portes</th>
                            <th style="text-align: right;">I.G.V.</th>
                            <th style="text-align: right;">Total Letra</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="capital" t-value="0"/>
                        <t t-set="bill_amount_total" t-value="0"/>
                        <t t-set="interest" t-value="0"/>
                        <t t-set="freight_interest" t-value="0"/>
                        <t t-set="igv" t-value="0"/>
                        <t t-set="bill_amount_total_signed" t-value="0"/>
                            <tr t-foreach="o.bill_ids" t-as="l">
                                <td>
                                    <span style="text-align: left;" t-esc="l.bill_number"/>
                                </td>
                                <td>
                                    <span style="text-align: left;" t-esc="l.order_id.name"/>
                                </td>
                                <td>
                                    <span style="text-align: left;" t-field="l.bill_date_issue"/>
                                </td>
                                <td>
                                    <span style="text-align: left;" t-field="l.bill_date_due"/>
                                </td>
                                <td>
                                    <span style="text-align: left;" t-field="l.interest_time"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%(l.capital)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%(l.interest)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%(l.freight_interest)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%(l.igv)" />
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'%.2f'%(l.bill_amount_total)"/>
                                </td>
                                <t t-set="capital" t-value="capital + l.capital"/>
                                <t t-set="interest" t-value="interest + l.interest"/>
                                <t t-set="freight_interest" t-value="freight_interest + l.freight_interest"/>
                                <t t-set="igv" t-value="igv + l.igv"/>
                                <t t-set="bill_amount_total" t-value="bill_amount_total + l.bill_amount_total"/>
                            </tr>
                        <tr/>
                        <tr>
                            <td style="text-align: right;" colspan="5">
                                <b>TOTALES: </b>
                            </td>
                            <td style="text-align: right; border-top: 1px solid black;">
                                <span t-esc="'%.2f'%(capital)"/>
                            </td>
                            <td style="text-align: right; border-top: 1px solid black;">
                                <span t-esc="'%.2f'%(interest)"/>
                            </td>
                            <td style="text-align: right; border-top: 1px solid black;">
                                <span t-esc="'%.2f'%(freight_interest)"/>
                            </td>
                            <td style="text-align: right; border-top: 1px solid black;">
                                <span t-esc="'%.2f'%(igv)"/>
                            </td>
                            <td style="text-align: right; border-top: 1px solid black;">
                                <span t-esc="'%.2f'%(bill_amount_total)"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>
            </div>
        </div>
    </template>

    <template id="advanced_bills_form2">
        
