    <record id="view_account_letras_payment_tree_fxo_schedule" model="ir.ui.view">
        <field name="name">account.letras.payment.tree.fxo.schedule</field>
        <field name="model">account.letras.payment</field>
        <field name="inherit_id" ref="account_letras_it.view_account_letras_payment_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="type_invoice" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
