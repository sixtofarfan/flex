                <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
                <attribute name="context">{'fxo_move_search': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='factura_ids']/tree/field[@name='nro_comprobante']" position="after">
