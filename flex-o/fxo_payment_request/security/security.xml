<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="group_fxo_payment_approvement" model="res.groups">
		<field name="name">Aprobar Solicitud de Pagos</field>
	</record>
	<record id="group_fxo_payment_request" model="res.groups">
		<field name="name">Solicitud de Pago</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	<record model="ir.rule" id="fxo_payment_request_not_shared_multi_company_rule">
		<field name="name">Non Shared Records: Solicitud de Pagos</field>
		<field name="model_id" ref="fxo_payment_request.model_fxo_payment_request"/>
		<field name="global" eval="True"/>
		<field name="domain_force">
			[('company_id', 'in', company_ids)]
		</field>
	</record>
	<record model="ir.rule" id="fxo_payment_request_line_not_shared_multi_company_rule">
		<field name="name">Non Shared Records: Lineas Solicitud de Pagos</field>
		<field name="model_id" ref="fxo_payment_request.model_fxo_payment_request_line"/>
		<field name="global" eval="True"/>
		<field name="domain_force">
			[('company_id', 'in', company_ids)]
		</field>
	</record>
</odoo>
