<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_main_parameter_form_inherit_adjust" model="ir.ui.view">
		<field name="name">main.parameter.form.inherit.adjust</field>
		<field name="model">main.parameter</field>
		<field name="inherit_id" ref="account_base_it.view_main_parameter_form"/>
		<field name="arch" type="xml">
			<xpath expr="//notebook" position="inside">
				<page name="payment_request" string="Solicitud de Pago">
					<group>
						<group>
							<field name="adjustment_amount"/>
							<field name="adjust_account_id"/>
							<field name="adjust_account_credit_id"/>
							<field name="custom_journal_id"/>
						</group>
					</group>
				</page>
			</xpath>
		</field>
	</record>
</odoo>