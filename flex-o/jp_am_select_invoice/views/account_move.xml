		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<!-- <xpath expr="//button[@name='action_duplicate']" position="after"> -->
				<!-- <button name="get_line" string="Debit" class="oe_highlight" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|',('type', '!=', 'entry'),('state','!=','draft')]}" context="{'type_line': 'debit'}"/>
