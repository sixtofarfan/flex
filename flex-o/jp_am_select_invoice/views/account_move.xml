				<!-- <button name="get_lines" string="Debit Line" class="oe_highlight" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|',('type', '!=', 'entry'),('state','!=','draft')]}" context="{'type_line': 'debit'}"/>
