<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_get_lines_wizard" model="ir.ui.view">
            <field name="name">get.lines.wizard.form</field>
            <field name="model">get.lines.wizard</field>
            <field name="arch" type="xml">
                <form string="Get Lines Wizard">
                    <group>
                        <field name="lines" nolabel="1">
                        <!-- domain="[('full_reconcile_id', '=', False),('amount_residual', '>', 0),('parent_state','=','posted')]"-->
                        <!-- domain="[('account_internal_type','in',('payable','receivable'))]"> -->
                            <tree>
                                <field name="name"/>
                                <field name="ref"/>
                                <field name="move_name"/>
                                <field name="account_id"/>
                                <field name="move_name"/>
                                <field name="currency_id"/>
                                <field name="amount_currency"/>
                                <field name="balance"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button string="Get Lines" name="insert" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>