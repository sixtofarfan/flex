<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_get_invoices_lines_wizard" model="ir.ui.view">
            <field name="name">get.invoices.lines.wizard.form</field>
            <field name="model">get.invoices.lines.wizard</field>
            <field name="arch" type="xml">
                <form string="Get Invoices Wizard">
                    <group>
                        <field name="invoices" nolabel="1"
                        domain="[('state','=','posted'),('type','in',('out_invoice','in_invoice'))]"/>
                    </group>
                    <footer>
                        <button string="Get Invoices" name="insert" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>