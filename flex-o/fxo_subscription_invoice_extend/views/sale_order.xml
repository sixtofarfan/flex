<odoo>
	<record id="sale_order_form_inherit_months" model="ir.ui.view">
		<field name="name">sale.order.form.inherit.months</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form/group/group[1]/div[@name='discount']/field[@name='discount']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group[1]/div[@name='discount']" position="after">
                <field name="qty_months" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>