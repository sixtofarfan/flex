<odoo>
	<record id="product_pricelist_item_form_inherit_discount" model="ir.ui.view">
		<field name="name">product.pricelist.item.form.inherit.discount</field>
		<field name="model">product.pricelist.item</field>
		<field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
		<field name="arch" type="xml">
            <xpath expr="//label[@for='percent_price']" position="before">
                <label for="discount_extra" attrs="{'invisible':[('compute_price', '!=', 'percentage')]}"/>
                <div attrs="{'invisible':[('compute_price', '!=', 'percentage')]}">
                    <field name="discount_extra"
                    class="oe_inline"
                    attrs="{'invisible':[('compute_price', '!=', 'percentage')]}"/>
                    %%
                </div>
                <field name="default_months"/>
            </xpath>
        </field>
    </record>
</odoo>