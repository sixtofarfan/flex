<odoo>
  <data>

    <record id="import_xml_file_wizard" model="ir.ui.view">
        <field name="name">Import XML Invoice</field>
        <field name="model">import.xml.file</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Import XML Invoice">
                <!-- <h2>Select a journal to generate the payments</h2>
                <field name="journal_id" required="1" domain="[('type','=','bank')]"/> -->
                <h3>Select a XML Invoice to import</h3>
                <group>
                    <group>
                        <field name="tipe_import" required="1"/>
                        <field name="diario" required="1"/>
                    </group>
                    <group>
                        <field name="tipo_document" required="1"/>
                    </group>
                </group>
                <group>
                    <field name="lineas" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2" required="1"/>
                </group>
                <footer>
                    <button name="import_file" string="_Import" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>



