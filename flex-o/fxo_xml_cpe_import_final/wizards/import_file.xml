            <field name="type">ir.actions.act_window</field>
            <field name="res_model">import.xml.file</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_import_xml_invoice2" 
                id="menu_importarxmlfacturas" 
                parent="account.menu_finance_entries_accounting_miscellaneous" 
                sequence="1" 
                />




    <record id="import_xml_file_wizardaccount" model="ir.ui.view">
        <field name="name">Actualizar Cuentas Facturas Importadas</field>
        <field name="model">import.xlm.update</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Import XML Invoice">
                <!-- <h2>Select a journal to generate the payments</h2>
                <field name="journal_id" required="1" domain="[('type','=','bank')]"/> -->
                <h3>Actualizar Cuenta</h3>
                <group>
                    <group>
                        <field name="cuenta" required="1"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button name="update" string="Actualizar" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


        <record id="action_import_xml_invoiceaccount_line" model="ir.actions.act_window">
            <field name="name">Actualizar Cuentas Facturas Importadas</field>
            <field name="res_model">import.xlm.update</field>
            <field name="binding_model_id" ref="model_account_move_line"/>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

  </data>
