<odoo>
	<record model="ir.ui.view" id="account_collection_report_form">
		<field name="name">account.collection.report.form</field>
		<field name="model">account.collection.report</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<group>
						<field name="currency_id" required="True"/>
					</group>
					<group>
						<field name="status_id"/>
					</group>
				</group>
				<footer>
					<button string="Generar Reporte" name="generate_collection_report" type="object" class="oe_highlight"/> 
					<button string="Cancel" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="account_collection_report_tree" model="ir.ui.view">
		<field name="name">account.collection.report.tree</field>
		<field name="model">account.collection.report</field>
		<field name="arch" type="xml">
			<tree>
				<field name="currency_id"/>
			</tree>
		</field>
	</record>

	<record id="action_get_collection_wizard" model="ir.actions.act_window">
		<field name="name">Informe de Cobranzas</field>
		<field name="res_model">account.collection.report</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
	
	<menuitem
		action="action_get_collection_wizard"
		id="menu_fxo_payment_request_account"
		parent="account_base_it.menu_treasury"
		sequence="1"
	/>
</odoo>