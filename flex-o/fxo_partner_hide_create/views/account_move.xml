<odoo>
	<record id="account_move_form_inherit_hide_create" model="ir.ui.view">
		<field name="name">account.move.form.inherit.hide.create</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<field name="partner_id" position="attributes">
				<attribute name="options">{&quot;always_reload&quot;: True,'no_create_edit':True}</attribute>
				<attribute name="widget"></attribute>
			</field>
		</field>
	</record>
	<record id="view_order_form_inherit_hide_create" model="ir.ui.view">
		<field name="name">sale.order.inherit.hide.create</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">
			<field name="partner_id" position="attributes">
				<attribute name="options">{&quot;always_reload&quot;: True,'no_create_edit':True}</attribute>
			</field>
		</field>
	</record>
	<record id="purchase_order_form_inherit_hide_create" model="ir.ui.view">
		<field name="name">purchase.order.inherit.hide.create</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<field name="partner_id" position="attributes">
				<attribute name="options">{'no_create_edit':True}</attribute>
			</field>
		</field>
	</record>
	<record id="stock_picking_form_inherit_hide_create" model="ir.ui.view">
		<field name="name">stock.picking.inherit.hide.create</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form"/>
		<field name="arch" type="xml">
			<field name="partner_id" position="attributes">
				<attribute name="options">{'no_create_edit':True}</attribute>
			</field>
		</field>
	</record>
</odoo>