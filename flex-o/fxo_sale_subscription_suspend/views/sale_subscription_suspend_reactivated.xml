<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription_suspend_reactivated_form" model="ir.ui.view">
        <field name="name">sale_subscription_suspend_reactivated_form</field>
        <field name="model">sale.subscription.suspend.reactivated</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="set_draft" string="Volver a Borrador" states="confirmed" type="object"
                            class="oe_highlight"
                            groups="fxo_sale_subscription_suspend.group_subscription_suspend_reactivated"/>
                    <button name="set_confirm" string="Confirmar" states="draft" type="object" class="oe_highlight"
                            groups="fxo_sale_subscription_suspend.group_subscription_suspend_reactivated"
                    />
                    <button name="set_done" string="Realizar" type="object" class="oe_highlight" states="confirmed"
                            confirm="¿Está seguro que desea realizar la operación?, una vez hecho esto ya no se podrán hacer modificaciones."
                            groups="fxo_sale_subscription_suspend.group_subscription_request_approved"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="field_name" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" widget="radio" options="{'horizontal':true}"/>
                            <field name="company_id" force_save="1" options="{'no_create': 1, 'no_edit': 1}"/>
                            <field name="request_date" force_save="1"/>
                            <field name="request_user_id" force_save="1"
                                   options="{'no_create': 1, 'no_edit': 1}"/>
                        </group>
                        <group>
                            <field name="observations"/>
                            <field name="confirmed_date"/>
                            <field name="confirmed_user_id" force_save="1"
                                   options="{'no_create': 1, 'no_edit': 1}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscriptions">
                            <field name="subscription_ids" options="{'no_create': 1, 'no_edit': 1}">
                                <tree>
                                    <field name="code" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="date_start"/>
                                    <field name="recurring_next_date"/>
                                    <field name="pricelist_id" invisible="1"/>
                                    <field name="user_id" optional="show"/>
                                    <field name="team_id" optional="hide"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                                    <field name="recurring_total"/>
                                    <field name="percentage_satisfaction"/>
                                    <field name="stage_id"/>
                                    <field name="to_renew" invisible="1"/>
                                    <field name="in_progress" invisible="1"/>
                                    <field name="activity_exception_decoration" widget="activity_exception"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_subscription_suspend_reactivated_tree" model="ir.ui.view">
        <field name="name">sale.subscription.suspend.reactivated.tree</field>
        <field name="model">sale.subscription.suspend.reactivated</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="type"/>
                <field name="observations"/>
                <field name="request_date"/>
                <field name="confirmed_date"/>
                <field name="request_user_id"/>
                <field name="confirmed_user_id"/>
                <field name="company_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="sale_subscription_suspend_reactivated_search" model="ir.ui.view">
        <field name="model">sale.subscription.suspend.reactivated</field>
        <field name="arch" type="xml">
            <search>
                <field name="type"/>
                <field name="observations"/>
                <field name="request_date"/>
                <field name="confirmed_date"/>
                <field name="request_user_id"/>
                <field name="confirmed_user_id"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter name="request_date_filter" string="Request Date" domain="[]"
                            context="{'group_by': 'request_date'}"/>
                    <filter name="confirmed_date_filter" string="Confirmed Date" domain="[]"
                            context="{'group_by': 'confirmed_date'}"/>
                    <filter name="request_user_id_filter" string="Request User" domain="[]"
                            context="{'group_by': 'request_user_id'}"/>
                    <filter name="confirmed_user_id_filter" string="Request User" domain="[]"
                            context="{'group_by': 'confirmed_user_id'}"/>
                    <filter name="state_filter" string="Estado" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sale_subscription_suspend_reactivated" model="ir.actions.act_window">
        <field name="name">Solicitudes de Suspensión y Reactivación de Servicios</field>
        <field name="res_model">sale.subscription.suspend.reactivated</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
            id="menu_sale_subscription_suspend_reactivated"
            parent="sale.sale_order_menu"
            sequence="6"
            action="action_sale_subscription_suspend_reactivated"
            groups="fxo_sale_subscription_suspend.group_subscription_suspend_reactivated"
    />


    <record id="sale_subscription_stage_id_view_form" model="ir.ui.view">
        <field name="name">sale_subscription_stage_id.form</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Historial de suspensiones y reactivaciones">
                    <group>
                        <field name="stage_suspend_reactivated_ids" nolabel="1" readonly="1">
                            <tree>
                                <field name="name" optional="hide"/>
                                <field name="observations" optional="hide"/>
                                <field name="request_date"/>
                                <field name="request_user_id"/>
                                <field name="confirmed_date"/>
                                <field name="confirmed_user_id"/>
                                <field name="company_id" optional="hide"/>
                                <field name="type"/>
                                <field name="state" invisible="1"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>