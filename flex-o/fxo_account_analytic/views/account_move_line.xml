<odoo>
	<data>
		<record id="view_move_line_form_inherit" model="ir.ui.view">
			<field name="name">account.move.line.form.inherit</field>
			<field name="model">account.move.line</field>
			<field name="inherit_id" ref="account.view_move_line_form"/>
			<field name="arch" type="xml">
				<xpath expr="//notebook/page[1]/group/group[last()]" position="after">
					<group string="Otra Informacion">
						<field name="user_id"/>
						<field name="sale_team_id"/>
						<field name="partner_street_destination" context="{'default_type': 'delivery'}"/>
						<field name="categ_id"/>
					</group>
				</xpath>
			</field>
		</record>
		<record id="view_move_form_inherit_analytic" model="ir.ui.view">
			<field name="name">view.move.form.inherit_analytic</field>
			<field name="model">account.move</field>
			<field name="inherit_id" ref="account.view_move_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="after">
					<field name="user_id" optional="hide"/>
					<field name="sale_team_id" optional="hide"/>
					<field name="partner_street_destination" context="{'default_type': 'delivery'}" optional="hide"/>
					<field name="categ_id" optional="hide"/>
				</xpath>
				<xpath expr="//field[@name='line_ids']/tree/field[@name='credit']" position="after">
					<field name="user_id" optional="hide"/>
					<field name="sale_team_id" optional="hide"/>
					<field name="partner_street_destination" context="{'default_type': 'delivery'}" optional="hide"/>
					<field name="categ_id" optional="hide"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>
