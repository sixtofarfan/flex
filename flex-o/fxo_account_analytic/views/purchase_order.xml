<odoo>
	<data>
		<record id="purchase_order_form_inherit_partner_destination" model="ir.ui.view">
			<field name="name">purchase.order.form.inherit.partner_destination</field>
			<field name="model">purchase.order</field>
			<field name="inherit_id" ref="purchase.purchase_order_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
					<field name="partner_street_destination" context="{'default_type': 'delivery'}"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>