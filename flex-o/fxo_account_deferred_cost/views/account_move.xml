	<record model="ir.actions.server" id="action_get_difered_wizard">
		<field name="name">Generar Asientos de Provision</field>
		<field name="model_id" ref="account.model_account_move"/>
		<field name="binding_model_id" ref="account.model_account_move" />
		<field name="state">code</field>
		<field name="code">action = records.get_difered_wizard()</field>
	</record>-->
	<record model="ir.actions.server" id="action_get_difered_wizard_tax">
		<field name="name">Diferir Impuestos</field>
		<field name="model_id" ref="account.model_account_move"/>
		<field name="binding_model_id" ref="account.model_account_move" />
		<field name="state">code</field>
		<field name="code">action = records.get_difered_wizard_tax_confirmation()</field>
	</record>
	<record model="ir.actions.server" id="action_get_difered_wizard_tax_move">
		<field name="name">Generar Asientos de Impuestos</field>
		<field name="model_id" ref="account.model_account_move"/>
		<field name="binding_model_id" ref="account.model_account_move" />
		<field name="state">code</field>
		<field name="code">action = records.get_difered_wizard_tax()</field>
	</record>
	<record model="ir.actions.server" id="action_get_difered_wizard_derive">
		<field name="name">Diferir Gastos o Ingresos</field>
		<field name="model_id" ref="account.model_account_move"/>
		<field name="binding_model_id" ref="account.model_account_move" />
		<field name="state">code</field>
		<field name="code">action = records.get_difered_wizard_derive()</field>
	</record>
</odoo>