<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="am_detraction_payment_wizard_form" model="ir.ui.view">
		<field name="name">am.detraction.payment.wizard.form</field>
		<field name="model">am.detraction.payment.wizard</field>
		<field name="arch" type="xml">
			<form>
				<field name="move_line_ids">
					<tree>
						<field name="name"/>
						<field name="move_id"/>
						<field name="partner_id"/>
						<field name="account_id"/>
						<field name="journal_id"/>
						<field name="debit"/>
						<field name="credit"/>
					</tree>
				</field>
				<footer>
					<button string="Agregar" name="add_lines" type="object" class="oe_highlight"/> 
					<button string="Cancel" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>