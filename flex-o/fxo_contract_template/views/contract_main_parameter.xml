<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="contract_main_parameter_form" model="ir.ui.view">
		<field name="name">contract.main.parameter.form</field>
		<field name="model">contract.main.parameter</field>
		<field name="arch" type="xml">
			<form string="Parametros Principales">
				<sheet>
					<notebook>
						<page name="configuration" string="Configuracion">
							<group string="Datos Principales">
								<group>
									<field name="manager_id"/>
									<field name="electronic_doc"/>
									<field name="company_slogan"/>
									<field name="client_slogan"/>
								</group>
								<group>
									<field name="proxies_ids" widget="many2many_tags"/>
								</group>
							</group>
							<group>
								<group string="QUINTA.- OBLIGACIONES DE FIBERLUX:">
									<field name="resolution"/>
									<field name="anticipated_hours"/>
									<field name="organism"/>
								</group>
								<group string="NOVENA.- RESOLUCIÓN">
									<field name="article"/>
									<field name="articles"/>
								</group>
								<group string="DECIMO PRIMERA.- PROTECCIÓN DE DATOS PERSONALES">
									<field name="law"/>
									<field name="approver"/>
									<field name="law2"/>
								</group>
							</group>
						</page>
						<page name="monthly_target" string="Objetivo Mensual">
							<group string="NIVELES DE LOS SERVICIOS Y PENALIDADES">
								<field name="capital_percent"/>
								<field name="province_percent"/>
							</group>
							<field name="var_lines">
								<tree>
									<field name="name"/>
									<field name="description"/>
								</tree>
							</field>
						</page>
						<page name="incidents" string="Incidencias y Escalamiento">
							<group>
								<group>
									<field name="support"/>
								</group>
								<group>
									<field name="monitoring"/>
								</group>
							</group>
							<field name="service_lines">
								<tree>
									<field name="name"/>
								</tree>
							</field>
						</page>
						<page name="support" string="Reporte de Solicitud para soporte">
							<field name="contact_lines">
								<tree>
									<field name="name"/>
									<field name="email"/>
									<field name="contact"/>
								</tree>
							</field>
						</page>
						<page name="level" string="Niveles de Escalamiento">
							<field name="escalation_lines" nolabel="1">
								<tree>
									<field name="name"/>
									<field name="description"/>
								</tree>
							</field>
						</page>
						<page name="phone" string="Telefonos de Contacto">								
							<field name="phone_lines" nolabel="1">
								<tree>
									<field name="name"/>
									<field name="noc"/>
									<field name="telephony"/>
									<field name="soc"/>
								</tree>
							</field>
						</page>
						<page name="glossary" string="Glosario">
							<field name="glossary_lines">
								<tree>
									<field name="name"/>
									<field name="description"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>
	<record id="contract_main_parameter_tree" model="ir.ui.view">
		<field name="name">contract.main.parameter.tree</field>
		<field name="model">contract.main.parameter</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name"/>
				<field name="company_id" groups="base.group_multi_company"/>
			</tree>
		</field>
	</record>
	<record id="action_contract_main_parameter" model="ir.actions.act_window">
		<field name="name">Parametros Principales de Contratos</field>
		<field name="res_model">contract.main.parameter</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Crea tu primera tabla de Parametros de Contrato aqui
			</p>
		</field>
	</record>
	<menuitem 
		action="action_contract_main_parameter" 
		id="menu_contract_main_parameter" 
		parent="sale_subscription.menu_sale_subscription_config" 
		sequence="11" 
		groups="sale_subscription.group_sale_subscription_manager"/>
</odoo>