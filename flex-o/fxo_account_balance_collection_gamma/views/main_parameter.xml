<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_main_parameter_form_inherit_period" model="ir.ui.view">
        <field name="name">view.main.parameter.form.inherit.period</field>
        <field name="model">main.parameter</field>
        <field name="inherit_id" ref="account_base_it.view_main_parameter_form"/>
        <field name="arch" type="xml">
            <field name="rounding_gain_account" position="after">
                <field name="bill_account_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <!-- account.account inherit form view -->
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.inherit.view.form</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <!-- Add your xpath here -->
            <field name="user_type_id" position="after">
                <field name="is_not_account_analytic" />
            </field>

        </field>
    </record>
</odoo>