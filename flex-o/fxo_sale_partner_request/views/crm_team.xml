<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- Add you code here -->
        
        <!-- crm.team.router.request form view -->
        <record id="crm_team_router_request_form" model="ir.ui.view">
            <field name="name">crm.team.router.request.view.form</field>
            <field name="model">crm.team.router.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud De Permanencia">
                <header>
                    <button name="confirm" states="draft" type="object" string="Set to Confirmed"/>
                    <button name="set_draft" states="confirmed,canceled,done" type="object" string="Set to Draft"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,canceled,done"/>
                </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" required="1" domain="[('user_id', '=', user_id)]"/>
                                <field name="user_id"   readonly="1" />
                            </group>
                            <group>
                                <field name="date_request" required="1"/>
                                <field name="date_due" required="1"/>
                            </group> 
                        </group>
                        <group>
                            <field name="description" required="1"/> 
                        </group>
                        <notebook>
                            <page string="Approval Line" name="approval_line" >
                                <field name="approval_id" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="request_owner_id"/>
                                        <field name="category_id"/>
                                        <field name="date_confirmed"/>
                                        <field name="permanence_id"/>
                                        <field name="request_status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- crm.team.router.request tree view -->
        <record id="crm_team_router_request_tree" model="ir.ui.view">
            <field name="name">crm.team.router.request.view.tree</field>
            <field name="model">crm.team.router.request</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- Add your fields here -->
                    <field name="name"/>
                    <field name="description"/>
                    <field name="date_request"/>
                </tree>
            </field>
        </record>

        <record id="crm_team_type_action" model="ir.actions.act_window">
            <field name="name">Solicitud De Permanencia</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.team.router.request</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="crm_team_menu" 
            name="Solicitud De Permanencia" 
            parent="sale.sale_order_menu" 
            action="crm_team_type_action"
            sequence="5"/>
    </data>
</odoo>