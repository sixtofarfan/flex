        <record id="invoice_form_detraction_inherit" model="ir.ui.view">
            <field name="name">invoice.form.detraction.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='preview_invoice']" position="before">
                    <button name="%(action_account_invoice_detraction)d" id="account_invoice_detraction_btn" type="action"
                            attrs="{'invisible': ['|','|',('detraction_privisioned', '=', True),('state','not in',['posted']),('type', '=', 'entry')]}"
                            string="Provision Detraction" groups="account.group_account_invoice" class="oe_highlight"/>
                    <button name="cancel_privisioned_detraction" type="object"
                            attrs="{'invisible': ['|','|',('detraction_privisioned', '=', False),('state','not in',['posted']),('type', '=', 'entry')]}"
                            string="Cancel Provisioned Detraction" groups="account.group_account_invoice"/>
                    <field name="detraction_privisioned" invisible="1"/>
                </xpath>
            </field>
        </record>

