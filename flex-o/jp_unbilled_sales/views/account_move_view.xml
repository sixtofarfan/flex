<odoo>
  <data>

    <record model="ir.ui.view" id="view_invoice_tree_undelivered">
        <field name="name">view.view.invoice.filter.undelivered</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
          <filter name="late" position="after">
            <filter name="undelivered" string="Undelivered invoices" domain="[('undelivered_invoices', '=', True)]"/>
            <filter name="advanced" string="Advanced invoices" domain="[('advanced_invoices', '=', True)]"/>
            <filter name="without_picking" string="No picking invoices" domain="[('picking_ids', '=', False)]"/>
          </filter> 
        </field>
    </record>

  </data>
</odoo>