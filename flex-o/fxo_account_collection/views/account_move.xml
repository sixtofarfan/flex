<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_move_form_inherit_collection" model="ir.ui.view">
		<field name="name">move.form.inherit.collection</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<group id="other_tab_group" position="inside">
				<group name="collection_group" string="Recaudacion" attrs="{'invisible': [('type', 'not in', ('out_invoice', 'out_refund'))]}">
					<field name="collection_number"/>
					<field name="collection_date"/>
				</group>
			</group>
		</field>
	</record>
</odoo>