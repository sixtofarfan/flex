		web_icon="account,static/description/icon.png"
		sequence="40"/>
	<menuitem
		id="menu_finance_users"
		action="action_account_get_move_users"
		parent="menu_finance_users_root"
		groups="fxo_account_user_invoices.my_documents_group"
		sequence="1"/>
