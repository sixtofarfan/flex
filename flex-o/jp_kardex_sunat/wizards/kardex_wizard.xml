<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_kardex_wizard" model="ir.ui.view">
            <field name="name">kardex.wizard.form</field>
            <field name="model">kardex.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="initial_date"/>
                            <field name="locked_period" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                            <field name="include_nro_picking"/>
                        </group>
                        <group>
                            <field name="all_products" invisible="context.get('active_id')"/>
                            <field name="all_locations" domain="[('usage','=','internal')]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" invisible="context.get('active_id')" >
                            <field name="product_ids" nolabel="True" attrs="{'invisible': [('all_products','=', True)]}"/>
                        </page>
                        <page string="Locations">
                            <field name="location_ids" nolabel="True" attrs="{'invisible': [('all_locations','=', True)]}"/>
                        </page>
                    </notebook>
                    <footer>
                        <button name="get_kardex" string="Get Kardex" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                 </form>
             </field>
        </record>

        <record model="ir.actions.server" id="action_make_kardex_product_product">
            <field name="name">Valued Kardex</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="binding_model_id" ref="product.model_product_product" />
            <field name="state">code</field>
            <field name="code">action = records.get_kardex_product()</field>
        </record>

        <record model="ir.actions.server" id="action_make_kardex_product_template">
            <field name="name">Valued Kardex</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template" />
            <field name="state">code</field>
            <field name="code">action = records.get_kardex_template()</field>
        </record>

    </data>
</odoo>