<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_liquidation_vacation_line_tree_top" model="ir.ui.view">
		<field name="name">hr.liquidation.vacation.line.tree.top</field>
		<field name="model">hr.liquidation.vacation.line</field>
		<field name="inherit_id" ref="hr_social_benefits.hr_liquidation_vacation_line_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//tree" position="attributes">
				<attribute name="editable"/>
			</xpath>
		</field>
	</record>
	<record id="hr_liquidation_inherit_cts" model="ir.ui.view">
		<field name="name">hr.liquidation.inherit.cts</field>
		<field name="model">hr.liquidation</field>
		<field name="inherit_id" ref="hr_social_benefits.hr_liquidation_form"/>
		<field name="arch" type="xml">
			<button name="get_liquidation" position="attributes">
				<attribute name="confirm">¿Esta seguro que desea recalcular? Esto eliminara las lineas actuales y creara unas nuevas</attribute>
			</button>
			<button name="get_liquidation_employees" position="after">
				<button name="get_cts_employees" class="oe_stat_button" icon="fa-dollar" type="object" help="CTS" attrs="{'invisible': [('cts_count', '=', 0)]}">
					<div class="o_field_widget o_stat_info">
						<span class="o_stat_value"><field name="cts_count"/></span>
						<span class="o_stat_text">CTS</span>
					 </div>
				</button>
			</button>
			<field name="vacation_line_ids" position="attributes">
				<attribute name="context">{
					'tree_view_ref': 'hr_social_benefits.hr_liquidation_vacation_line_tree',
					'form_view_ref': 'fxo_hr_social_benefits.hr_liquidation_vacation_line_form',
				}</attribute>
			</field>
			<xpath expr="//notebook" position="inside">
				<page string="Conceptos Extra">
					<field name="liq_ext_concept_ids">
						<tree editable="bottom">
							<field name="employee_id"/>
							<field name="income"/>
							<field name="expenses"/>
							<button name="get_concepts_view" string="Agregar Concepto" type="object" class="oe_highlight"/>
						</tree>
					</field>
				</page>
			</xpath>
		</field>
	</record>
	<record id="hr_liquidation_vacation_line_form" model="ir.ui.view">
		<field name="name">hr.liquidation.vacation.line.form</field>
		<field name="model">hr.liquidation.vacation.line</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<field name="liquidation_id" invisible="1"/>
					<button name="get_computed_line" string="Recalcular" type="object" class="oe_highlight" attrs="{'invisible': [('liquidation_id', '=', False)]}"/>
				</header>
				<group>
					<group>
						<field name="identification_id" readonly="1"/>
						<field name="last_name" readonly="1"/>
						<field name="m_last_name" readonly="1"/>
						<field name="names" readonly="1"/>
						<field name="admission_date" readonly="1"/>
						<field name="compute_date" readonly="1"/>
						<field name="cessation_date" readonly="1"/>
						<field name="membership_id" readonly="1"/>
						<field name="months" readonly="0"/>
						<field name="days" readonly="0"/>
						<field name="lacks" readonly="0"/>
						<field name="wage" readonly="1"/>
						<field name="household_allowance" readonly="1"/>
						<field name="commission" readonly="0"/>
						<field name="bonus" readonly="0"/>
						<field name="extra_hours" readonly="0"/>
						<field name="is_worked_day"/>
						<field name="basic_worked_day"/>
					</group>
					<group>
						<field name="computable_remuneration" readonly="1"/>
						<field name="amount_per_month" readonly="1"/>
						<field name="amount_per_day" readonly="1"/>
						<field name="vacation_per_month" readonly="1"/>
						<field name="vacation_per_day" readonly="1"/>
						<field name="advanced_vacation" readonly="0"/>
						<field name="accrued_vacation" readonly="0"/>
						<field name="truncated_vacation" readonly="1"/>
						<field name="total_vacation" force_save="1" readonly="1"/>
						<field name="onp" force_save="1" readonly="1"/>
						<field name="afp_jub" force_save="1" readonly="1"/>
						<field name="afp_si" force_save="1" readonly="1"/>
						<field name="afp_mixed_com" force_save="1" readonly="1"/>
						<field name="afp_fixed_com" force_save="1" readonly="1"/>
						<field name="total" force_save="1" readonly="1"/>
					</group>
				</group>
			</form>
		</field>
	</record>
	<record id="hr_extra_concept_form" model="ir.ui.view">
		<field name="name">hr.extra.concept.form</field>
		<field name="model">hr.extra.concept</field>
		<field name="arch" type="xml">
			<form>
				<group>
					<group>
						<field name="name" required="1"/>
						<field name="amount" required="1"/>
					</group>
					<group>
						<field name="type" required="1"/>
					</group>
				</group>
			</form>
		</field>
	</record>
	<record id="hr_extra_concept_tree" model="ir.ui.view">
		<field name="name">hr.extra.concept.tree</field>
		<field name="model">hr.extra.concept</field>
		<field name="arch" type="xml">
			<tree editable="bottom">
				<field name="name"/>
				<field name="amount" sum="amount"/>
				<field name="type"/>
				<button name="unlink" type="object" icon="fa-trash-o"/>
			</tree>
		</field>
	</record>
	<record id="hr_extra_concept_search" model="ir.ui.view">
		<field name="name">hr.extra.concept.search</field>
		<field name="model">hr.extra.concept</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="amount"/>
				<field name="type"/>
				<filter name="group_type" string="Tipo" domain="[]" context="{'group_by':'type'}"/> 
			</search>
		</field>
	</record>
</odoo>