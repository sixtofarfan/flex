                            <table width="100%" style="background: white;">
                             <br/>
                                    <tr style="background: white;">
                                        <td width="20%" style="background: white;padding:3px"><span>RAZÓN SOCIAL</span></td>
                                        <td width="60%" style="background: white;">: <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr style="background: white;">
                                        <td style="background: white; padding:3px"><span t-esc="o.company_id.country_id.vat_label or 'TIN'">: </span></td>
                                        <td style="background: white;">:
