                                    </t>
                                </t>
                            </t>
                        </td>
                        
                        <td style="background: white; line-height: 110%;" width="10%" class="text-right">
                            <span t-field="l.price_unit"/>
                        </td>
                        <td  style="background: white;line-height: 110%; text-align: right;" width="7%">
                          <span t-field="l.discount"/> 
                        </td>

                        <td style="background: white; line-height: 110%;" width="15%" class="text-right">
                            <t t-set="total" t-value="l.price_unit * l.quantity"/>
                            <span t-att-style="fontsize" t-esc="'%.2f'%(l.price_subtotal)"/>                                        
                        </td>
                    </tr>
                </table> 
                </div>
                <!-- <div align="left" style="border:1px solid #ff8e16;   width: 97%;   "> 
                    <span>SON: <span t-esc="o.amount_text"/></span>
                </div> -->
            </div>

            <div style="width:97%;">
                <p/>
                <table width="97%" style="background: white;">
                    <tr style="background: white;">
                       
                        <td width="30%" style="background: white;">
                            <div class="row">
                                <div class="col-xs-12"  style="padding: 0mm; border: 1px solid white;">
                                    
                                </div>
                            </div>
                        </td>
                        <td width="30%" align="center" style="background: white; padding-left:40px;">
                            <!-- <p t-field="company.invoice_note" style=" text-align: left;margin-bottom:0px; margin-right:5px; margin-top:10px; border: 1px solid #ff8e16;border-radius: 5px; width:100%; padding-left:5px;">    
                            </p>
                            <br/>
                            <p t-field="company.report_footer" style=" text-align: left;margin-bottom:0px; margin-right:5px; margin-top:10px; border: 1px solid #ff8e16;border-radius: 5px; width:100%; padding-left:5px;">    
                            </p> -->
                        </td>
                        <td style=" background: white;  text-align: right;  ">
                            <br/>
                            <div align="center" style="border:1px solid #ff8e16; border-radius:22px;  align: right; width: 90%; height:30px ; margin-left: 40px;  ">
                                <table width="95%" style="padding-left:5px; background: white; margin-top:5px; margin-right:5px;">
                                    <tr>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="50%"> SUB - TOTAL:</td>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="10%">  <t t-esc="o.currency_id.symbol"/></td>
                                        <td style="padding-left:5px; background: white; " align="right" width="40%"> <t t-esc="'%.2f'%o.amount_untaxed"/> </td>
                                    </tr>
                                </table>
                            </div>
                            <br/>
                            
                            
                            <div align="center"  style="border:1px solid #ff8e16; border-radius:22px;  align: right; width: 90%; height:30px ; margin-left: 40px;  ">
                                <table width="95%" style="padding-left:5px; background: white; margin-top:5px; margin-right:5px;">
                                    
                                    
                                    <tr>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="50%"> IGV:</td>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="10%">  <t t-esc="o.currency_id.symbol"/></td>
                                        <td style="padding-left:5px; background: white; " align="right" width="40%"> <t t-esc="amount_tax"/> </td>
                                    </tr>
                                </table>
                            </div>
                             <br/>
                            
                            
                            
                           <div align="center" style="border:1px solid #ff8e16; border-radius:22px;  align: right; width: 90%; height:30px ; margin-left: 40px;  ">
                                <table width="95%" border="1" style="padding-left:5px; background: white; margin-top:5px; margin-right:5px;">
                                    <tr>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="50%">  TOTAL:</td>
                                        <td style="padding-left:5px; background: white; text-aling:left;" width="10%">  <t t-esc="o.currency_id.symbol"/></td>
                                        <td style="padding-left:5px; background: white; " align="right" width="40%">  <t t-esc="'%.2f'%o.amount_total"/> </td>
                                    </tr>
                                </table>
                            </div>
                            <br/>
                            
                        </td>
                        
                    </tr>
                </table>
                
            </div>

        </div>
    </t>
</template>
