                                            <span t-field="o.partner_id.vat"/>
                                        </t> 
                                        <t t-if="not o.partner_id.vat">
                                            <span style="font-size: 0px; color: white;" id="xxx" t-field="o.partner_id.vat"/>
                                            <span id="fechaxxx"/>
                                        </t> 

                                        <span t-if="o.partner_id.phone"> 
                                        <span style="padding-left:50px; ">  Telefono : <span t-field="o.partner_id.phone"/></span></span>
                                        <span t-if="o.partner_id.mobile">                             
                                        <span style="padding-left:50px;">  Celular : <span t-field="o.partner_id.mobile"/></span></span>
                                        </td>
                                    </tr>
                                    <tr style="background: white;"><t t-if="o.partner_id.street"><td style="background: white; padding:3px"><span>DIRECCIÓN </span></td>
                                        <td style="background: white;">: <span t-field="o.partner_id.street"/></td></t>
                                    </tr>
                                    <tr style="background: white;"><t t-if="o.partner_id.street"><td style="background: white; padding:3px"><span>DISTRITO </span></td>
                                        <td style="background: white;">: <span t-field="o.partner_id.district_id"/></td></t>
                                    </tr>
                                    
                                    <tr style="background: white;">
                                        <td style="background: white; padding:3px"><span>TIPO DE MONEDA</span></td>
                                        <td style="background: white;">: <t t-esc="o.currency_id.name"/>
                                        </td>
                                    </tr>
                                    
                            </table>
                        </td>
                        <td width="30%">
                             <table width="100%" style="background: white;">
                                <br/>
                                <tr style="background: white;">
                                    <td width="40%" style="background: white; padding:3px"><span>FECHA EMISIÓN</span></td>
                                    <td width="60%" style="background: white;">: <span t-esc="o.invoice_date"/>
                                    </td>
                                </tr>
                                <tr style="background: white;">
                                    <td width="40%"  style="background: white; padding:3px"><span>FECHA VENCIMIENTO</span></td>
                                    <td width="60%"  style="background: white;">: <span t-esc="o.invoice_date_due"/>
                                    </td>
                                </tr>
                                <!-- <tr style="background: white;">
                                   <td  width="40%" style="background: white; padding:3px"><span>G.R. REMITENTE </span></td>
                                   <td  width="60%" style="background: white;">:  <span t-if="o.fx_piking_reference">  <span t-field="o.fx_piking_reference" /></span> 
                                    </td>
                                </tr> -->
                                <tr style="background: white;">
                                    <td  width="40%" style="background: white; padding:3px"><span>CONDICIONES DE PAGO </span></td>
