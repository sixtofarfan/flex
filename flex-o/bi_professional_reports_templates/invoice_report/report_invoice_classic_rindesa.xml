                                    </td>
                                </tr>
                                <tr style="background: white;">
                                    <td  width="40%" style="background: white; padding:3px"><span>ORDEN DE COMPRA    </span></td>
                                   <td   width="60%" style="background: white;">: <span t-if="o.name"> <span t-field="o.name"/></span>
                                    </td>
                                </tr>            
                                             
                             </table>
                        </td>
                    </tr>
                    
                    
                </table>
                </div>
            </div>

            <div>
                <p/>
                <table width="97%" style="border:1px solid #ff8e16;font-size: 12px;">
                    <tr style=" background-color: #ff8e16; color: #FFF;">
                        
                        <th style="border:1px solid #ff8e16;text-align: right;width:10%;">CANTIDAD</th>
                        <th style="border:1px solid #ff8e16;text-align: letf;width:8%;">UNIDAD</th>
                        <th style="border:1px solid #ff8e16;text-align: center;width:45%;">DESCRIPCIÓN</th>
                        <th style="border:1px solid #ff8e16;text-align: right;width:15%;">P. UNITARIO</th>
                        <th style="border:1px solid #ff8e16;text-align: right;width:7%;"> DSCT.</th>
                        <th style="border:1px solid #ff8e16;text-align: right;width:15%;">P. TOTAL</th>
                    </tr>
                </table>
	  	<!-- height:700px para reducir o ampliar pie de pagina -->
                <div align="left" style="border:1px solid #ff8e16;   width: 97%; height:550px ;    "> 
                <table style="   width: 100%;  ">
