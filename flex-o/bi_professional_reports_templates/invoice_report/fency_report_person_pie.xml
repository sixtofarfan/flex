<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="person_report_invoice_pie_document_header">
            <div class="header">
                <style type="text/css">
                table {background: white;}
                tr {background: white;}
                td {background: white;}     
                </style>
                <t t-if="o and o.company_id">
                    <t t-set="company" t-value="o.company_id"></t>
                </t>
                <t t-if="o and o.company_id and o.company_id.partner_id">
                    <t t-set="partner" t-value="o.company_id.partner_id"></t>
                </t>
                <table style="text-align: center;" width="97%">
                    <tr>
                        <td width="25%">
                        <br/>
                            <div class="col-sm-4">
                                <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % to_text(company.logo)" style="max-height: 100px;"/>
                            </div>
                        </td>
                        <td width="45%">
                            <div style="font-size: 10px; text-align: center;">
                                <br/><br/>
                                <b><span style="font-size: 10px;" t-field="company.name"/></b><br/>
                                <t t-if="company.street">
                                    <span t-field="company.street"/>                                    
                                </t>
                                <t t-if="company.phone">
                                    <br/>                                    
                                    Teléfono: <span t-field="company.phone"/>
                                    <t t-if="partner.mobile"> 
                                    <span style="padding-left:10px;">Móvil: <span t-field="partner.mobile"/></span> 
                                    </t>                        
                                </t>

                                <t t-if="company.email">
                                    <br/>                                   
                                    E-mail: <span t-field="company.email"/>
                                </t>
                                <br/>
                                <br/>
                                
                            </div>

                        </td>
                        <td width="30%">
                            <br/><br/>
                            <div style="border: 1px solid; border-radius: 15px; font-size: 13px">
                                <p>
                                    <script type="text/javascript">
                                        setInterval(function(){
                                            var str = document.getElementById("xxx").innerHTML; 
                                            var res = str.substr(0, 3);
                                            document.getElementById("fechaxxx").innerHTML = res;
                                            });

                                            function myFunction() {
                                            var str = "Hello world!"; 
                                            var res = str.substr(0, 10);
                                            document.getElementById("demo").innerHTML = res; 
                                            }
                                    </script>
                                    <br/>
                                    R.U.C <span t-field="o.company_id.partner_id.vat"/>
                                    <br/> <br/>
                                    
                                    <!-- <t style="border: 1px solid black" t-if="o.pe_doc_name">
                                        <t>
                                            <b><span t-field="o.pe_doc_name" /></b>
                                        </t>
                                    </t>
                                    <t style="border: 1px solid black" t-if="not o.pe_doc_name">
                                        <t>
                                            <b><span t-field="o.journal_id.pe_invoice_code" /></b>
                                        </t>
                                    </t>                            
                                    <br/><br/> -->
                                    <span id="xxx" style="color: red;" t-field="o.ref"/>
                                    <br/>
                                </p>
                            </div>
                        </td>
                    </tr>
                </table>
            </div> 
            <div class="footer">
                <div class="row">
                    <div  style="border: 1px solid black; width: 240mm;"/>
                    <br/>
                    <div class="text-center" style="width: 190mm; padding-left: 40mm; font-size: 11px;">
                        <ul class="list-inline">
                            <li t-if="company.phone"><i class="fa fa-phone"/> <span t-field="company.phone"/></li>
                            <li t-if="company.email"><i class="fa fa-at"/> <span t-field="company.email"/></li>
                            <li t-if="company.website"><i class="fa fa-globe"/> <span t-field="company.website"/></li>
