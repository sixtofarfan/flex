                                <td style="background: white; line-height: 110%;padding:5px">
                                    <span t-field="l.product_id.name"/>
                                </td>
                                <td class="text-right" style="background: white; line-height: 110%;">
                                    <span t-field="l.quantity"/>
                                </td>
                                <td style="background: white;line-height: 110%;"><span t-field="l.uom_id"  groups="product.group_uom"/></td>
                                <td style="background: white; line-height: 110%;" class="text-right">
                                    <span t-field="l.price_unit"/>
                                </td>
                                <td style="background: white; line-height: 110%;" class="text-right">
                                    <t t-set="total" t-value="l.price_unit * l.quantity"/>
                                    <span  t-att-style="fontsize" t-esc="l.price_subtotal"/>                                        
                                </td>
                            </tr>
                        </table>  
                    </div>

                    <!-- ################################################################################################   -->

                    <p/>
                    <div  class="text-center" style="  margin-top:35%; bottom: 0;  width: 100%;">
                        <div style="font-size: 12px; background: white;">
                            <table width="97%" style="background: white; text-align: center;" border="1">
                                <!-- <tr style="background: white;">
                                    <td colspan="6" style="background: white; border: 1px solid black;padding:3px;margin:0px;text-align:left;">
                                        <span>MONTO EN LETRAS: <span t-esc="o.amount_text"/></span>
                                    </td>
                                </tr>                     -->
                                <tr style="background: white;">
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">OP.GRABADAS</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">OP.INAFECTAS</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">OP.EXONERADAS</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">OP.GRATUITAS</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">IGV</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">TOTAL</td>
                                </tr>
                                <tr>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <t  t-if="o.amount_tax &gt; 0">
                                            <span t-field="o.amount_untaxed"/>                                    
                                        </t>
                                        <t t-if="not o.amount_tax &gt; 0.1">
                                            <span>- -</span>
                                        </t>                                                             
                                    </td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">- -</td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <t t-if="o.amount_tax &lt;= 0">
                                            <span t-field="o.amount_untaxed"/>                                    
                                        </t>
                                        <t t-if="not o.amount_tax &lt;= 0">
                                            <span>- -</span>
                                        </t>                                                                  
                                    </td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <t t-if="not o.amount_tax &lt;= 0">
                                            <span>- -</span>
                                        </t>                              
                                    </td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <span t-field="o.amount_tax"/>
                                    </td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <span t-field="o.amount_total"/>
                                    </td>
                                </tr>
                            </table>
                            <p/>
                            
                        </div>

                        <!-- ################################################################################################   -->

                        
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>

