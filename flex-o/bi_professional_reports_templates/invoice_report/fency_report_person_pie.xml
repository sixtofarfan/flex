                                    </td>
                                    <td style="background: white; border: 1px solid black;padding:3px;margin:0px;">
                                        <span t-field="o.amount_total"/>
                                    </td>
                                </tr>
                            </table>
                            <p/>
                            
                        </div>

                        <!-- ################################################################################################   -->

                        
                    </div>
                </div>
            </t>
        </template>
