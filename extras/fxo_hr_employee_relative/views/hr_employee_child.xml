<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_child_view_form" model="ir.ui.view">
        <field name="name">hr.employee.child.view.form</field>
        <field name="model">hr.employee.child</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="names" placeholder="Nombres" required="True"/>
                        </h1>
                        <h1>
                            <field name="last_name" placeholder="Apellido Paterno" required="True"/>
                        </h1>
                        <h1>
                            <field name="m_last_name" placeholder="Apellido Materno" required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="birth_date"/>
                            <field name="limit_date"/>
                            <field name="family_bond_id"/>
                        </group>
                        <group>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="proof_studies"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_employee_child_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.child.view.tree</field>
        <field name="model">hr.employee.child</field>
        <field name="arch" type="xml">
            <tree>
                <field name="names"/>
                <field name="last_name"/>
                <field name="m_last_name"/>
                <field name="employee_id"/>
                <field name="birth_date"/>
                <field name="limit_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="proof_studies"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
    <record id="hr_employee_child_action" model="ir.actions.act_window">
		<field name="name">Parientes</field>
		<field name="res_model">hr.employee.child</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Crea tu primera tabla de Parientes aqui
			</p>
		</field>
	</record>
    <menuitem
		id="menu_hr_employee_child"
		action="hr_employee_child_action"
		parent="hr_payroll.menu_hr_payroll_employees_root"
		sequence="22"
		groups="hr_base_it.group_hr_tables_root"
	/>
</odoo>
