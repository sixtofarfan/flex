<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_child_view_form" model="ir.ui.view">
        <field name="name">hr.employee.child.view.form</field>
        <field name="model">hr.employee.child</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="names" placeholder="Nombres" required="True"/>
                        </h1>
                        <h1>
                            <field name="last_name" placeholder="Apellido Paterno" required="True"/>
                        </h1>
                        <h1>
                            <field name="m_last_name" placeholder="Apellido Materno" required="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="birth_date"/>
                            <field name="limit_date"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="proof_studies"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_employee_child_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.child.view.tree</field>
        <field name="model">hr.employee.child</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="birth_date"/>
                <field name="limit_date"/>
                <field name="gender"/>
                <field name="proof_studies"/>
            </tree>
        </field>
    </record>
</odoo>
