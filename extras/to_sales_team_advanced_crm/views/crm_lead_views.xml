<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record model="ir.ui.view" id="crm_lead_view_form">
			<field name="name">crm.lead.form.opportunity</field>
			<field name="model">crm.lead</field>
			<field name="inherit_id" ref="crm.crm_lead_view_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='team_id']" position="after">
					<field name="team_leader_id" groups="base.group_no_one"
						force_save="1" />
					<field name="regional_manager_id" groups="base.group_no_one"
						force_save="1" />
					<field name="crm_team_region_id" groups="base.group_no_one"
						force_save="1" />
				</xpath>
			</field>
		</record>

	</data>
</odoo>
