<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_stock_move_line_operation_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <field name="lot_name" position="after">
                    <field name="code" invisible="1"/>
                    <field name="expiration_date"
                           attrs="{'readonly': ['|',('code', '!=', 'incoming'),'&amp;', ('package_level_id', '!=', False), ('parent.picking_type_entire_packs', '=', True)]}"
                           groups="stock.group_production_lot" force_save="1"/>
                    <field name="use_date"
                           attrs="{'readonly': ['|',('code', '!=', 'incoming'),'&amp;', ('package_level_id', '!=', False), ('parent.picking_type_entire_packs', '=', True)]}"
                           groups="stock.group_production_lot" force_save="1"/>
                    <field name="manufacturing_date"
                           attrs="{'readonly': ['|',('code', '!=', 'incoming'),'&amp;', ('package_level_id', '!=', False), ('parent.picking_type_entire_packs', '=', True)]}"
                           groups="stock.group_production_lot" force_save="1"/>

                </field>
            </field>
        </record>

        <record id="view_stock_move_line_detailed_operation_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.operations.tree.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <field name="lot_name" position="after">
                    <field name="expiration_date" invisible="context.get('show_lots_text')" attrs="{ 'invisible': [('lots_visible', '=', False)],'readonly': [('parent.picking_type_code', '!=', 'incoming')]}"
                           groups="stock.group_production_lot" force_save="1"/>
                    <field name="use_date"
                           invisible="context.get('show_lots_text')" attrs="{ 'invisible': [('lots_visible', '=', False)],'readonly': [('parent.picking_type_code', '!=', 'incoming')]}"
                           groups="stock.group_production_lot" force_save="1"/>
                    <field name="manufacturing_date"
                           invisible="context.get('show_lots_text')" attrs="{ 'invisible': [('lots_visible', '=', False)],'readonly': [('parent.picking_type_code', '!=', 'incoming')]}"
                           groups="stock.group_production_lot" force_save="1"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
