<odoo>
    <record id="xpath_sale_order_form" model="ir.ui.view">
        <field name="name">xpath.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
                <attribute name="domain">False</attribute>
            </xpath>
        </field>
    </record>
</odoo>
