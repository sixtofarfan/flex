<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.owncloud</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cloud_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div name="cloud_base" position="attributes">
                <attribute name="string">OwnCloud</attribute>
                <attribute name="data-key">owncloud_odoo</attribute>
            </div>
            <button name="action_reset" position="before">
                <button name="action_login_owncloud"
                        string="Login and confirm"
                        type="object"
                        style="margin-left: 5px;"
                        attrs="{'invisible': [('cloud_client_state', '=', 'confirmed')]}"
                        class="oe_highlight"

                />
            </button>
            <group name="client_specific" position="inside">
                <field name="owncloud_url"
                       attrs="{'readonly': [('cloud_client_state', '=', 'confirmed')]}"
                       placeholder="https://myfiles.com"
                />
                <field name="owncloud_login"
                       attrs="{'readonly': [('cloud_client_state', '=', 'confirmed')]}"
                />
                <field name="owncloud_password"
                       attrs="{'readonly': [('cloud_client_state', '=', 'confirmed')]}"
                       password="True"
                />
                <field name="owncloud_root_dir"
                       attrs="{'readonly': [('cloud_client_state', 'in', ['confirmed', 'reconnect'])]}"
                />
                <field name="owncloud_share_urls"/>
            </group>
        </field>
    </record>

    <record id="cloud_base.cloud_config_action" model="ir.actions.act_window">
        <field name="context">{'module' : 'owncloud_odoo'}</field>
        <field name="name">Settings</field>
    </record>

</odoo>
