<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_advance_ducpliate" model="ir.actions.server">
		<field name="name">Duplicar Adelantos</field>
		<field name="model_id" ref="hr_advances_and_loans.model_hr_advance"/>
		<field name="binding_model_id" ref="hr_advances_and_loans.model_hr_advance"/>
		<field name="state">code</field>
		<field name="code">action = records.duplicate_custom()</field>
	</record>



	<record model="ir.ui.view" id="hr_advance_duplicate_form">
		<field name="name">hr.advance.duplicate.form</field>
		<field name="model">hr.advance.duplicate</field>
		<field name="arch" type="xml">
			<form string="Duplicar Adelantos">
				<group>
					<group>
						<field name="date_advance"/>
						<field name="date_payment"/>
					</group>
					<group>
					</group>
				</group>
				<footer>
					<button string="Duplicar" name="make_advances" type="object" class="oe_highlight"/>
					<button string="Cancel" class="oe_link" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>